LVS_CHECK_PROPERTY rm10 l l -TOLERANCE RES_Lerr
LVS_REDUCE_DEVICE rm10 -PARALLEL YES
[ TOLERANCE l 0
  EFFECTIVE w,l
  l = sum(l)/count()
  w = sum(w)
]
LVS_REDUCE_DEVICE rm10 -SERIES PLUS MINUS YES
[ TOLERANCE w 0
  effective w,l
  w = sum(w)/count()
  l = sum(l)
]
#ELSE
