DEVICE mimcap_um_sin_rf RCTM_RF1P0 ctm(PLUS) cbm(MINUS) shield(BULK) <L_EG_RG> [
  property lt,wt,mimflag
  lt = perimeter_coincide(RCTM_RF1P0,L_EG_RG)/2
  wt = area(RCTM_RF1P0)/lt
  mimflag = 1
]
