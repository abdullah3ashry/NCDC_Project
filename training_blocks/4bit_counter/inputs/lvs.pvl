   SCALE = PRESCALE
   W = (perimeter_coincide(ngatelpg, tndiff ) + perimeter_inside(ngatelpg, tndiff)) / 2
   L = area(ngatelpg) / W
   LODX_1 = DFM_VEC_VAL( lod_PROP, "PER_1" )
