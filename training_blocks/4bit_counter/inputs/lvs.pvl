//   M[nch_hvt]       CORE HIGH-VT NMOS          ((NGATE-OD25-OD18-OD33-OD5-OD6-NT_Ni)-DNW-EHVT_N-ELVT_N*VTH_N-SRM-DCO)  
//   M[nch_hvt_dnw]   CORE HIGH-VT NMOS/DNW      ((NGATE-OD25-OD18-OD33-OD5-OD6-NT_Ni)*DNW-EHVT_N-ELVT_N*VTH_N-SRM)  
//   M[nch_uhvt]      CORE ULTRA-HIGH-VT NMOS     ((NGATE-OD25-OD18-OD33-OD5-OD6-NT_Ni)-DNW-OD1T*UHVT_N) 
//   M[nch_uhvt_dnw]  CORE ULTRA-HIGH-VT NMOS/DNW ((NGATE-OD25-OD18-OD33-OD5-OD6-NT_Ni)*DNW-OD1T*UHVT_N) 
//   M[nch_ulvt]      CORE ULTRA-LOW-VT NMOS      ((NGATE-OD25-OD18-OD33-OD5-OD6-NT_Ni)-DNW-OD1T*VTUL_N) 
//   M[nch_ulvt_dnw]  CORE ULTRA-LOW-VT NMOS/DNW  ((NGATE-OD25-OD18-OD33-OD5-OD6-NT_Ni)*DNW-OD1T*VTUL_N) 
//   M[nch_mlvt]      CORE ILVT NMOS            ((NGATE-OD25-OD18-OD33-OD5-OD6-NT_Ni)-DNW*ILVT-SRM) 
//   M[nch_mlvt_dnw]  CORE ILVT NMOS/DNW        ((NGATE-OD25-OD18-OD33-OD5-OD6-NT_Ni)*DNW*ILVT-SRM) 
// 
// 
