//MOS erc_nmos_gates S/D connect to POWER&GROUND --mnpg*/
SELECT_NET tndiff POWER_NAME -OUTPUT N1tndiff;
SELECT -TOUCH erc_nmos_gates N1tndiff T1tndiff;
SELECT_NET tndiff GROUND_NAME -OUTPUT N2tndiff;
SELECT -TOUCH erc_nmos_gates N2tndiff T2tndiff;

#IFDEF DS_TO_PG_CHECK
rule "mnpg" {
  caption MOS connected to both power and ground;
  AND T1tndiff T2tndiff;
}
#ENDIF

//MOS erc_pmos_gates S/D connect to POWER&GROUND --mppg*/
SELECT_NET tpdiff POWER_NAME -OUTPUT N1tpdiff;
SELECT -TOUCH erc_pmos_gates N1tpdiff T1tpdiff;
SELECT_NET tpdiff GROUND_NAME -OUTPUT N2tpdiff;
SELECT -TOUCH erc_pmos_gates N2tpdiff T2tpdiff;

#IFDEF DS_TO_PG_CHECK
rule "mppg" {
  caption MOS connected to both power and ground;
  AND T1tpdiff T2tpdiff;
}
#ENDIF

//MOS erc_nmos_gates S/D connect to POWER&GROUND --mnpg_ldd1*/
SELECT_NET d_nd25hvdw POWER_NAME -OUTPUT N1d_nd25hvdw_mnpg_ldd1A;
SELECT -TOUCH erc_nmos_gates N1d_nd25hvdw_mnpg_ldd1A T1d_nd25hvdw_mnpg_ldd1A;
SELECT_NET s_nd25hvdw GROUND_NAME N2s_nd25hvdw_mnpg_ldd1A;
SELECT -TOUCH erc_nmos_gates N2s_nd25hvdw_mnpg_ldd1A T2s_nd25hvdw_mnpg_ldd1A;

SELECT_NET s_nd25hvdw POWER_NAME N1s_nd25hvdw_mnpg_ldd1B;
SELECT -TOUCH erc_nmos_gates N1s_nd25hvdw_mnpg_ldd1B T1s_nd25hvdw_mnpg_ldd1B;
SELECT_NET d_nd25hvdw GROUND_NAME N2d_nd25hvdw_mnpg_ldd1B;
SELECT -TOUCH erc_nmos_gates N2d_nd25hvdw_mnpg_ldd1B T2d_nd25hvdw_mnpg_ldd1B;

#IFDEF DS_TO_PG_CHECK
rule "mnpg_ldd1" {
 caption MOS connected to both power and ground;
 AND T1d_nd25hvdw_mnpg_ldd1A T2s_nd25hvdw_mnpg_ldd1A mnpg_ldd1_tmp1;
 AND T1s_nd25hvdw_mnpg_ldd1B T2d_nd25hvdw_mnpg_ldd1B mnpg_ldd1_tmp2;
 OR mnpg_ldd1_tmp1 mnpg_ldd1_tmp2;
}
#ENDIF

//MOS erc_pmos_gates S/D connect to POWER&GROUND --mppg_ldd1*/
SELECT_NET d_pd25hvd POWER_NAME -OUTPUT N1d_pd25hvd_mppg_ldd1A;
SELECT -TOUCH erc_pmos_gates N1d_pd25hvd_mppg_ldd1A T1d_pd25hvd_mppg_ldd1A;
SELECT_NET s_pd25hvd GROUND_NAME N2s_pd25hvd_mppg_ldd1A;
SELECT -TOUCH erc_pmos_gates N2s_pd25hvd_mppg_ldd1A T2s_pd25hvd_mppg_ldd1A;

SELECT_NET s_pd25hvd POWER_NAME N1s_pd25hvd_mppg_ldd1B;
SELECT -TOUCH erc_pmos_gates N1s_pd25hvd_mppg_ldd1B T1s_pd25hvd_mppg_ldd1B;
SELECT_NET d_pd25hvd GROUND_NAME N2d_pd25hvd_mppg_ldd1B;
SELECT -TOUCH erc_pmos_gates N2d_pd25hvd_mppg_ldd1B T2d_pd25hvd_mppg_ldd1B;

#IFDEF DS_TO_PG_CHECK
rule "mppg_ldd1" {
 caption MOS connected to both power and ground;
 AND T1d_pd25hvd_mppg_ldd1A T2s_pd25hvd_mppg_ldd1A mppg_ldd1_tmp1;
 AND T1s_pd25hvd_mppg_ldd1B T2d_pd25hvd_mppg_ldd1B mppg_ldd1_tmp2;
 OR mppg_ldd1_tmp1 mppg_ldd1_tmp2;
}
#ENDIF

#IFDEF FLOATING_WELL_CHECK
SCONNECT tndiff nxwell_float -by nplug;
rule "floating.nxwell_float" {
  caption  nxwell_float is not connected to POWER;
  pathchk nxwell_float -power not -ports_also no_power_path;
  select_net nxwell_float GROUND_NAME -output direct_connect_ground;
  or no_power_path direct_connect_ground;
}
#ENDIF

#IFDEF FLOATING_WELL_CHECK
SCONNECT tndiff nxwell_hv -by ntaphv;
rule "floating.nxwell_hv" {
  caption  nxwell_hv is not connected to POWER;
  pathchk nxwell_hv -power not -ports_also no_power_path;
  select_net nxwell_hv GROUND_NAME -output direct_connect_ground;
  or no_power_path direct_connect_ground;
}
#ENDIF

#IFDEF FLOATING_WELL_CHECK
rule "floating.psub" {
  caption  psub is not connected to GROUND;
  pathchk psub -ground not -ports_also no_ground_path;
  select_net psub POWER_NAME -output direct_connect_power;
  or no_ground_path direct_connect_power;
}
#ENDIF
SELECT_NET gate1_not_IO2_not_IO2 GROUND_NAME -OUTPUT gate1_not_IO2_GND;

#IFDEF GATE_TO_PG_CHECK
// gate1_not_IO2 connect to ground 
rule "npvss150" {
  caption gate1_not_IO2 connected to GROUND;
  SELECT -INTERACT gate1_not_IO2_GND N2tndiff -eq 2 gate1_not_IO2_GND1
  NOT gate1_not_IO2_GND gate1_not_IO2_GND1
}
#ENDIF

#IFDEF WELL_TO_PG_CHECK
// ntap connect to ground 
rule "npvss49" {
  caption ntap connected to GROUND
  NOT ntap VAR ntap_not_var;
  SELECT_NET ntap_not_var GROUND_NAME;
}
#ENDIF

#IFDEF PATH_CHECK

// Nodes with a path to ground but not power 
pathchk  -ground -and -power not  g_np
select_check -erc   GROUND_nPOWER ;
rule  GROUND_nPOWER  {
   caption  A path to ground but no path to power
   copy g_np;
}
#ENDIF

#IFDEF PATH_CHECK

// Nodes with a path to power but not ground 
pathchk  -ground not -and -power  ng_p
select_check -erc   nGROUND_POWER ;
rule  nGROUND_POWER  {
   caption  A path to power but no path to ground
   copy ng_p;
}
#ENDIF

#IFDEF PATH_CHECK

// Nodes without a path to power and ground 
pathchk  -ground not -and -power not -nofloat  ng_np
select_check -erc   nGROUND_nPOWER ;
rule  nGROUND_nPOWER  {
   caption  No path to power and no path to ground
   copy ng_np;
}
#ENDIF

#IFDEF PATH_CHECK

// No label and no float 
pathchk  -labeled not -nofloat  nlabel
select_check -erc   nLabel ;
rule  nLabel  {
   caption  No label and no float
   copy nlabel;
}
#ENDIF
NOT gate1_not_IO2 OD25_28 gate1_not_IO2_not_IO1
NOT gate1_not_IO2_not_IO1 OD33 gate1_not_IO2_not_IO2
CONNECT gate1_not_IO2_not_IO2 poly
SELECT_NET gate1_not_IO2_not_IO2 POWER_NAME -OUTPUT gate1_not_IO2_PWR;

#IFDEF GATE_TO_PG_CHECK
// gate1_not_IO2 connect to power 
rule "ppvdd150" {
  caption gate1_not_IO2 connected to POWER;
  SELECT -INTERACT gate1_not_IO2_PWR N1tpdiff -eq 2 gate1_not_IO2_PWR1
  NOT gate1_not_IO2_PWR gate1_not_IO2_PWR1
}
#ENDIF

#IFDEF WELL_TO_PG_CHECK
// ptap connect to power 
rule "ppvdd49" {
  caption ptap connected to POWER;
  SELECT_NET ptap POWER_NAME;
}
#ENDIF

#ENDIF
