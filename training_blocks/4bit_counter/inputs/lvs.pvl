//   M[nch_lpg]      LPG Nominal VT NMOS        ((NGATE-OD25-OD18-OD33-OD5-OD6-NT_Ni)-DNW-SRM-OD1T*DCO)  
//   M[nch_lpghvt]   LPG HIGH-VT NMOS           ((NGATE-OD25-OD18-OD33-OD5-OD6-NT_Ni)-DNW*VTH_N-SRM*DCO)  
