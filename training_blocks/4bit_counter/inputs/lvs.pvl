//#############################################
//# LOGIC OPERATION POOL                      #
//#############################################

//Form BULK layer
EXTENT DRC:1;
SIZE DRC:1 -BY 0.005 BULK;

//* Define device -- nmos nch
AND POI RH rpolywo1;
AND rpolywo1 RPO rpolywo2;
OR RPDMYi RPDMY1 RPDMY;
OR ODI DOD OD;
AND RODMY SRM rodsrm;
NOT OD rodsrm diffa;
SELECT -INTERACT diffa CO diff ;
SELECT -INTERACT RPDMY diff -NOT rp1;
SELECT -INTERACT rp1 POI p1rdum ; //  poly1 resistor dummy
SELECT -INTERACT rpolywo2 p1rdum rpolywo ;
NOT POI rpolywo poly1;
AND POI p1rdum rpoly1;
SELECT -INTERACT rpoly1 RPO -NOT rpoly;
NOT poly1 rpoly poly21;
OR poly21 DPO poly_org; //   Poly interconnect 
COPY poly_org poly;
SELECT -INSIDE poly diff dumpo1 ;
SELECT -INTERACT dumpo1 CO -NOT dumpo2;
NOT poly dumpo2 realpo;
AND diff RH rodwo1;
AND rodwo1 RPO rodwo2;
SELECT -INTERACT RPDMY diff drdum ; //  diff resistor dummy
SELECT -INTERACT rodwo2 drdum rodwo3 ;
SELECT -INTERACT rodwo3 ODI rodwo ;
NOT diff rodwo mdiff1;
AND diff drdum rod1;
SELECT -INTERACT rod1 RPO -NOT rod2;
SELECT -INTERACT rod2 ODI rod ;
NOT mdiff1 rod mdiff;
AND realpo mdiff gate11;
AND realpo RBCDMY poly_rbc_dmy1;
OR GTDMY1 GTDMY2 GTDMY;
SELECT -INTERACT poly_rbc_dmy1 GTDMY -NOT poly_rbc_dmy;
NOT gate11 poly_rbc_dmy gate1;
SELECT -INTERACT RFDMY RBCDMY -NOT RFDMY_pure;
AND gate1 RFDMY_pure gate_a_rfi1;
NOT gate_a_rfi1 SRM gate_a_rfi; //  All RF devices except RBC cells
SELECT -INTERACT poly CO poly_rf1 ;
SELECT -INTERACT poly_rf1 DRAIN poly_rf ; //  only poly interact DRAIN are valid for pure RF
AND gate_a_rfi poly_rf gate_rfb;
NOT gate1 gate_rfb gate_a;
AND gate1 RBCDMY gate_a_rbc; //  RBC RF cells
SELECT -INTERACT poly_rf1 GTDMY poly_rbc ; //  only poly interact GTDMY are valid for RBC
AND gate_a_rbc poly_rbc gate_rbc;
NOT gate_a gate_rbc gate_b;
OR gate_a_rbc gate_a_rfi gate_a_rf;
SELECT -INTERACT mdiff DRAIN rf_diff ;
SELECT -INTERACT gate_a_rf rf_diff poly_rf_all ;
SELECT -INTERACT poly_rf_all CO -NOT poly_rf_noco;
NOT gate_b poly_rf_noco gate;
NOT gate SRM gate_nosr1;
COPY HVNWi HVNW;
NOT gate_nosr1 HVNW gate_nosr2;
COPY HVPWi HVPW;
NOT gate_nosr2 HVPW gate_nosr3;
NOT gate_nosr3 HVPSUB gate_nosr;
OR NWDMYi NWDMY1 NWDMY;
NOT NW NWDMY nxwella;
NOT nxwella HVNW nxwell; //  define N_well region
NOT gate_nosr nxwell gatennw; //  gate not inside nwell
AND gatennw NP tngate1;
COPY tngate1 tngate1a;
NOT tngate1a OD5 tngate1b;
NOT tngate1b OD6 tngate1c;
NOT tngate1c OD25 tngate2;
NOT tngate2 OD33 tngate3;
NOT tngate3 OD18 tngate4;
NOT tngate4 NT_Ni tngate5;
NOT tngate5 DNW tngate6;
AND tngate6 VTL_N nlvgate_org11;
COPY nlvgate_org11 nlvgate_org1;
NOT tngate6 nlvgate_org1 ngate1;
AND tngate6 VTH_N nhvgate1;
NOT nhvgate1 DCO nhvgate2;
NOT ngate1 nhvgate2 ngate21;
NOT tngate6 VTH_N nehvgate1;
NOT nehvgate1 DCO nehvgate2;
NOT nehvgate2 ELVT_N nehvgate_org1;
AND nehvgate_org1 EHVT_N nehvgate_org;
NOT ngate21 nehvgate_org ngate22;
AND nehvgate2 ELVT_N nelvgate_org;
NOT ngate22 nelvgate_org ngate2;
NOT tngate6 OD1T tngate7;
AND tngate7 VTUL_N nuvgate_org1;
NOT ngate2 nuvgate_org1 ngate31;
AND tngate6 UHVT_N nuhvgate_org1;
NOT ngate31 nuhvgate_org1 ngate3;
NOT ngate3 OD1T ngate4;
NOT ngate4 ILVT ngate51;
AND gate1 NP hngate0;
AND hngate0 HVPSUB hngate1;
NOT ngate51 hngate1 ngate5;
NOT ngate5 DCO ngate_org1;
COPY ngate_org1 ngate_org;
NOT ngate_org MAC ngate; //  CORE NMOS

//***** Define connectivity/via layer -- tndiff ****
AND mdiff NP nthin1;
AND ESD3 OD ydio_a;
SIZE ydio_a -BY -0.2 ydio_c
AND ydio_c NP ydio_d;
AND ydio_d RPO ydio_e;
NOT ydio_e NW ydio_f;
AND ESD3 POI ydio_g;
SIZE ydio_g -BY 0.2 ydio_h
NOT ydio_f ydio_h ydio_i;
SIZE ydio_i -BY -0.8 ydio_j
SIZE ydio_j -BY 0.6 ydio
NOT nthin1 ydio nthin; //  define N+ thin oxide
NOT nthin gate1 tndiffa; //  define N+ diffusion region
NOT diffa diff diffb;
AND diffb NP ndiffb;
OR tndiffa ndiffb tndiff_ori;
NOT tndiff_ori DRAIN s_tndiff1;
SELECT -OUTSIDE s_tndiff1 GTDMY2 s_tndiff1_1 ;
NOT gate_rfb VAR gate_rf;
OR gate_rbc gate_rf gate_rf_all;
SELECT -INTERACT s_tndiff1_1 gate_rf_all s_tndiff ;
NOT tndiff_ori s_tndiff tndiff_ori1;
SELECT -INTERACT s_tndiff1 GTDMY2 s_tndiff_cas1 ;
SELECT -INTERACT s_tndiff_cas1 CO s_tndiff_cas ;
NOT tndiff_ori1 s_tndiff_cas tndiff_ori2_1;
AND tndiff_ori HVD_NW d_nd25hvdw1;
NOT d_nd25hvdw1 HVD_DPW d_nd25hvdw;
NOT tndiff_ori2_1 d_nd25hvdw tndiff_ori2_2;
AND tndiff_ori HVD_DPW d_nd25hvi1;
AND d_nd25hvi1 HVD_NW d_nd25hvi;
NOT tndiff_ori2_2 d_nd25hvi tndiff_ori2;
AND tndiff_ori DRAIN d_tndiff;
NOT tndiff_ori2 d_tndiff tndiff;

//***** Define connectivity/via layer -- psub ****
OR HVNW NW anwel;
NOT BULK anwel ppsub; //  define total p_sub region
SIZE PSUB2 -BY 0.01 psub2s
NOT psub2s PSUB2 psubband; //   psub separator band (doughnut).
NOT ppsub psubband psub;

//* Define device -- nmos nch_mac
AND ngate_org MAC ngate_mac; //  CORE NMOS MAC

//* Define device -- nmos nch_lvt
COPY nlvgate_org1 nlvgate_org;
NOT nlvgate_org MAC nlvgate; //  CORE LOW_VT NMOS

//* Define device -- nmos nch_lvt_mac
AND nlvgate_org MAC nlvgate_mac; //  CORE LOW_VT NMOS MAC

//* Define device -- nmos nchpg_sr
AND gate SRM gate_s1a;
NOT gate_s1a HVNW gate_s1b;
NOT gate_s1b HVPW gate_s1c;
NOT gate_s1c HVPSUB gate_s1;
NOT gate_s1 nxwell gatennw_s; //  gate not inside nwell
AND gatennw_s NP ngate_s1;
NOT ngate_s1 OD5 ngate_s21;
NOT ngate_s21 OD6 ngate_s22;
NOT ngate_s22 OD25 ngate_s2;
NOT ngate_s2 OD33 ngate_s3;
NOT ngate_s3 OD18 ngate_s4;
NOT ngate_s4 VTL_N ngate_s5;
NOT ngate_s5 VTUL_N ngate_s611;
NOT ngate_s611 UHVT_N ngate_s612;
NOT ngate_s612 SRAMTIMER ngate_s61;
NOT ngate_s61 SRM14 ngate_s62;
NOT ngate_s62 SRM12 ngate_s63;
NOT ngate_s63 SRM13 ngate_s64;
NOT ngate_s64 SRM17 ngate_s65;
NOT ngate_s65 SRM16 ngate_s6;
NOT ngate_s6 VTH_N ngate_s_org1;
#IFDEF CELLIMP
 COPY SRM10 LPSRM10;
#ELSE
 SIZE SRM10 -BY 0.005 SRM10_1;
 NOT SRM10 SRM10_1 LPSRM10;
#ENDIF
NOT ngate_s_org1 LPSRM10 ngate_s_org2;
#IFDEF CELLIMP
 COPY SRM11 LPSRM11;
#ELSE
 SIZE SRM11 -BY 0.005 SRM11_1;
 NOT SRM11 SRM11_1 LPSRM11;
#ENDIF
NOT ngate_s_org2 LPSRM11 ngate_s_org;
NOT ngate_s_org DCO ngate_s;
AND ngate_s SRAMPSGT ngate_spg; //  SRAM NMOS passgate

//* Define device -- nmos nchpd_sr
NOT ngate_s SRAMPSGT ngate_spd; //  SRAM NMOS pulldown

//* Define device -- nmos nchpg_dpsr
NOT ngate_s62 SRM17 ngate_s71;
AND ngate_s71 SRM12 ngate_s7;
NOT ngate_s7 VTH_N ngate_sdp_org;
NOT ngate_sdp_org DCO ngate_sdp;
AND ngate_sdp SRAMPSGT ngate_spgdp; //  SRAM NMOS passgate ( 50,12 )

//* Define device -- nmos nchpd_dpsr
NOT ngate_sdp SRAMPSGT ngate_spddp; //  SRAM NMOS pulldown ( 50,12 )

//* Define device -- pmos pch
AND gate_nosr nxwell gatenw; //  gate inside nwell
AND gatenw PP tpgate1;
NOT tpgate1 OD5 tpgate1a;
NOT tpgate1a OD6 tpgate1b;
NOT tpgate1b OD25 tpgate2;
NOT tpgate2 OD33 tpgate3;
NOT tpgate3 OD18 tpgate4;
AND tpgate4 VTL_P plvgate_org11;
COPY plvgate_org11 plvgate_org1;
NOT tpgate4 plvgate_org1 pgate1;
AND tpgate4 VTH_P phvgate1;
NOT phvgate1 DCO phvgate2;
NOT pgate1 phvgate2 pgate21;
NOT tpgate4 VTH_P pehvgate1;
NOT pehvgate1 DCO pehvgate2;
NOT pehvgate2 ELVT_P pehvgate_org1;
AND pehvgate_org1 EHVT_P pehvgate_org;
NOT pgate21 pehvgate_org pgate22;
AND pehvgate2 ELVT_P pelvgate_org;
NOT pgate22 pelvgate_org pgate2;
NOT tpgate3 OD1T tpgate5;
AND tpgate5 VTUL_P puvgate_org1;
NOT pgate2 puvgate_org1 pgate31;
AND tpgate4 UHVT_P puhvgate_org1;
NOT pgate31 puhvgate_org1 pgate3;
NOT pgate3 ILVT pgate4;
NOT pgate4 OD1T pgate5;
NOT pgate5 DCO pgate6;
COPY pgate6 pgate_org;
NOT pgate_org MAC pgate; //  CORE PMOS

//***** Define connectivity/via layer -- tpdiff ****
AND mdiff PP pthin; //  define P+ thin oxide
NOT pthin gate1 tpdiffa; //  define P+ diffusion region
NOT diffb ndiffb pdiffb;
OR tpdiffa pdiffb tpdiff_ori;
NOT tpdiff_ori DRAIN s_tpdiff1;
SELECT -INTERACT s_tpdiff1 gate_rf s_tpdiff ;
NOT tpdiff_ori s_tpdiff tpdiff_ori1_1;
AND tpdiff_ori HVD_P d_pd25hvd;
NOT tpdiff_ori1_1 d_pd25hvd tpdiff_ori1;
AND tpdiff_ori DRAIN d_tpdiff;
NOT tpdiff_ori1 d_tpdiff tpdiff;

//* Define device -- pmos pch_mac
AND pgate_org MAC pgate_mac; //  CORE PMOS MAC

//* Define device -- pmos pch_lvt
COPY plvgate_org1 plvgate_org;
NOT plvgate_org MAC plvgate; //  CORE LOW_VT PMOS

//* Define device -- pmos pch_lvt_mac
AND plvgate_org MAC plvgate_mac; //  CORE LOW_VT PMOS MAC

//* Define device -- pmos pchpu_sr
AND gate_s1 nxwell gatenw_s; //  gate inside nwell
AND gatenw_s PP pgate_s1;
NOT pgate_s1 OD5 pgate_s21;
NOT pgate_s21 OD6 pgate_s22;
NOT pgate_s22 OD25 pgate_s2;
NOT pgate_s2 OD33 pgate_s3;
NOT pgate_s3 OD18 pgate_s4;
NOT pgate_s4 VTL_P pgate_s5;
NOT pgate_s5 VTUL_P pgate_s611;
NOT pgate_s611 UHVT_P pgate_s612;
NOT pgate_s612 SRAMTIMER pgate_s61;
NOT pgate_s61 SRM14 pgate_s62;
NOT pgate_s62 SRM12 pgate_s63;
NOT pgate_s63 SRM13 pgate_s64;
NOT pgate_s64 SRM17 pgate_s6;
NOT pgate_s6 VTH_P pgate_s_org1;
NOT pgate_s_org1 LPSRM10 pgate_s_org2;
NOT pgate_s_org2 LPSRM11 pgate_s_org;
NOT pgate_s_org DCO pgate_s; //  SRAM PMOS

//* Define device -- pmos pchpu_dpsr
NOT pgate_s62 SRM17 pgate_s71;
AND pgate_s71 SRM12 pgate_s7;
NOT pgate_s7 VTH_P pgate_sdp_org;
NOT pgate_sdp_org DCO pgate_sdp; //  SRAM PMOS( 50,12 )

//* Define device -- nmos nch_hvn
NOT hngate1 HVNW hngate2;
OR OD25 OD18 OD_thk;
OR OD_thk OD33 OD2;
NOT hngate2 OD2 hngate3;
NOT hngate3 NT_Ni hngate4;
NOT hngate4 VTL_N hngate5;
NOT hngate5 VTH_N hngate6;
NOT hngate6 UHVT_N hngate7;
NOT hngate7 DNW hngate8;
AND hngate8 HVPW hngate; //  Flash HV NMOS

//* Define device -- nmos nch_hvz
NOT hngate8 HVPW hzgate; //  Flash HV ZMOS

//* Define device -- pmos pch_hvp
AND gate1 PP hpgate0;
NOT hpgate0 HVPSUB hpgate1;
NOT hpgate1 HVPW hpgate2;
AND hpgate2 HVNW hpgate3;
NOT hpgate3 OD2 hpgate4;
NOT hpgate4 VTL_P hpgate5;
NOT hpgate5 VTH_P hpgate6;
NOT hpgate6 UHVT_P hpgate;

//* Define device -- nmos nch_dnw
AND tngate5 DNW tdgate1a;
NOT tdgate1a OD1T tdgate1;
AND tdgate1 VTL_N n1lvgate_org1;
NOT tdgate1 n1lvgate_org1 nrgate1;
AND tdgate1 VTH_N n1hvgate1;
NOT n1hvgate1 DCO n1hvgate_org1;
NOT nrgate1 n1hvgate_org1 nrgate21;
NOT tdgate1 VTH_N n1ehvgate1;
NOT n1ehvgate1 DCO n1ehvgate_org1;
NOT n1ehvgate_org1 ELVT_N n1ehvgate_org2;
AND n1ehvgate_org2 EHVT_N n1ehvgate_org;
NOT nrgate21 n1ehvgate_org nrgate22;
AND n1ehvgate_org1 ELVT_N n1elvgate_org;
NOT nrgate22 n1elvgate_org nrgate2;
AND tdgate1 VTUL_N n1uvgate_org1;
NOT nrgate2 n1uvgate_org1 nrgate31;
AND tdgate1 UHVT_N n1uhvgate_org1;
NOT nrgate31 n1uhvgate_org1 nrgate3;
NOT nrgate3 ILVT nrgate4;
NOT nrgate4 DCO nrgate_org1;
COPY nrgate_org1 nrgate_org;
NOT nrgate_org MAC nrgate; //  CORE NMOS on DNW

//* Define device -- nmos nch_dnw_mac
AND nrgate_org MAC nrgate_mac; //  CORE NMOS on DNW MAC

//* Define device -- nmos nch_hvt
NOT nhvgate2 EHVT_N nhvgate_org1;
NOT nhvgate_org1 ELVT_N nhvgate_org;
NOT nhvgate_org MAC nhvgate; //  CORE HIGH_VT NMOS

//* Define device -- nmos nch_hvt_dnw
NOT n1hvgate_org1 EHVT_N n1hvgate_org2;
NOT n1hvgate_org2 ELVT_N n1hvgate_org;
NOT n1hvgate_org MAC n1hvgate; //  CORE HIGH_VT NMOS on DNW

//* Define device -- nmos nch_hvt_mac
AND nhvgate_org MAC nhvgate_mac; //  CORE HIGH_VT NMOS MAC

//* Define device -- nmos nch_hvt_dnw_mac
AND n1hvgate_org MAC n1hvgate_mac; //  CORE HIGH_VT NMOS on DNW MAC

//* Define device -- nmos nch_lvt_dnw
COPY n1lvgate_org1 n1lvgate_org;
NOT n1lvgate_org MAC n1lvgate; //  CORE LOW_VT NMOS on DNW

//* Define device -- nmos nch_lvt_dnw_mac
AND n1lvgate_org MAC n1lvgate_mac; //  CORE LOW_VT NMOS on DNW

//* Define device -- nmos nch_ulvt
COPY nuvgate_org1 nuvgate_org;
NOT nuvgate_org MAC nuvgate; //  CORE ULTRA VT NMOS

//* Define device -- nmos nch_ulvt_dnw
COPY n1uvgate_org1 n1uvgate_org;
NOT n1uvgate_org MAC n1uvgate; //  CORE ULTRA VT NMOS on DNW

//* Define device -- nmos nch_ulvt_mac
AND nuvgate_org MAC nuvgate_mac; //  CORE ULTRA VT NMOS MAC

//* Define device -- nmos nch_ulvt_dnw_mac
AND n1uvgate_org MAC n1uvgate_mac; //  CORE ULTRA VT NMOS on DNW MAC

//* Define device -- nmos nch_uhvt
COPY nuhvgate_org1 nuhvgate_org;
NOT nuhvgate_org MAC nuhvgate; //  CORE ULTRA High VT NMOS

//* Define device -- nmos nch_uhvt_dnw
COPY n1uhvgate_org1 n1uhvgate_org;
NOT n1uhvgate_org MAC n1uhvgate; //  CORE ULTRA High VT NMOS on DNW

//* Define device -- nmos nch_uhvt_mac
AND nuhvgate_org MAC nuhvgate_mac; //  CORE ULTRA High VT NMOS MAC

//* Define device -- nmos nch_uhvt_dnw_mac
AND n1uhvgate_org MAC n1uhvgate_mac; //  CORE ULTRA High VT NMOS on DNW MAC

//* Define device -- nmos nch_lpg
NOT tngate5 nlvgate_org1 ngatelpg1;
NOT ngatelpg1 nhvgate2 ngatelpg2;
NOT ngatelpg2 nuvgate_org1 ngatelpg3;
NOT ngatelpg3 nuhvgate_org1 ngatelpg4;
NOT ngatelpg4 OD1T ngatelpg5;
NOT ngatelpg5 ILVT ngatelpg6;
AND tngate5 VTH_N nhvgate1a;
AND nhvgate1a DCO nhvgatelpg; //  CORE HIGH_VT LPG NMOS
NOT ngatelpg6 nhvgatelpg ngatelpg7;
AND ngatelpg7 DCO ngatelpg; //  CORE LPG NMOS

//* Define device -- nmos nch_lpgna
AND tngate4 NT_Ni nlgate1;
NOT nlgate1 VTL_N nlgate2;
NOT nlgate2 VTH_N nlgate3;
NOT nlgate3 VTUL_N nlgate4;
NOT nlgate4 DNW nlgate5;
NOT nlgate5 ILVT nlgate6;
AND nlgate6 DCO nlgatelpg; //  CORE LPG Devices

//* Define device -- nmos nch_na
NOT nlgate6 DCO nlgate7;
NOT nlgate7 MAC nlgate; //  CORE Native Devies

//* Define device -- nmos nch_na_mac
AND nlgate7 MAC nlgate_mac; //  CORE Native Devies MAC

//* Define device -- nmos nch_w
AND tngate5 OD1T ngate_1ta;
NOT ngate_1ta VTL_N ngate_1tb1;
COPY ngate_1tb1 ngate_1tb;
NOT ngate_1tb VTH_N ngate_1tc;
NOT ngate_1tc VTUL_N ngate_1td;
NOT ngate_1td CAP1TDMY ngate_1te;
SELECT -INTERACT ngate_1te p3 -NOT ngate_1tf;
NOT ngate_1tf DNW ngate_w1t; //  eDRAM nch_w device

//* Define device -- nmos nch_w_lvt
AND ngate_1tc VTUL_N ngate_1tg;
NOT ngate_1tg CAP1TDMY ngate_1th;
SELECT -INTERACT ngate_1th p3 -NOT ngate_1ti;
NOT ngate_1ti DNW ngate_w1t_lvt; //  eDRAM nch_w_lvt device

//* Define device -- nmos nch_dnw_w
AND ngate_1tf DNW ngate_dnw_w; //  eDRAM nch_dnw_w device

//* Define device -- nmos nch_dnw_w_lvt
AND ngate_1ti DNW ngate_dnw_w_lvt; //  eDRAM nch_dnw_w_lvt device

//* Define device -- nmos nch_dnw_1tr
AND ngate_1te DNW ngate_1te_dnw;
SELECT -INTERACT ngate_1te_dnw p3 ngate_1tr ; //   eDRAM nch_dnw_1tr device

//* Define device -- nmos nch_mlvt
AND ngate3 ILVT nilvtgate_org1;
COPY nilvtgate_org1 nilvtgate_org;
NOT nilvtgate_org MAC nilvtgate; //  LP NMOS MLVT device

//* Define device -- nmos nch_mlvt_dnw
AND nrgate3 ILVT n1ilvtgate_org1;
COPY n1ilvtgate_org1 n1ilvtgate_org;
NOT n1ilvtgate_org MAC n1ilvtgate; //  CORE LP NMOS MLVT device on DNW

//* Define device -- nmos nch_mlvt_mac
AND nilvtgate_org MAC nilvtgate_mac; //  LP NMOS MLVT device MAC

//* Define device -- nmos nch_mlvt_dnw_mac
AND n1ilvtgate_org MAC n1ilvtgate_mac; //  CORE LP NMOS MLVT device on DNW MAC

//* Define device -- pmos pch_mlvt
AND pgate3 ILVT pilvtgate_org1;
COPY pilvtgate_org1 pilvtgate_org;
NOT pilvtgate_org MAC pilvtgate; //  LP PMOS MLVT device

//* Define device -- pmos pch_mlvt_mac
AND pilvtgate_org MAC pilvtgate_mac; //  LP PMOS MLVT device MAC

//* Define device -- nmos nchpg_lpgsr
AND ngate_s_org DCO ngate_slpg;
AND ngate_slpg SRAMPSGT ngate_spglpg; //  SRAM LPG NMOS passgate

//* Define device -- nmos nchpd_lpgsr
NOT ngate_slpg SRAMPSGT ngate_spdlpg; //  SRAM LPG NMOS pulldown

//* Define device -- nmos nchpg_hvtsr
AND ngate_s65 VTH_N ngate_hvs1;
NOT ngate_hvs1 SRM_ULL ngate_hvs;
AND ngate_hvs SRAMPSGT ngate_hvspg; //  SRAM High VT NMOS passgate

//* Define device -- nmos nchpd_hvtsr
NOT ngate_hvs SRAMPSGT ngate_hvspd; //  SRAM High VT NMOS pulldown

//* Define device -- nmos nch_timer
AND ngate_s612 SRAMTIMER ngate_st;

//* Define device -- nmos nchpg_lpgdpsr
AND ngate_sdp_org DCO ngate_sdplpg;
AND ngate_sdplpg SRAMPSGT ngate_spglpgdp; //  SRAM LPG NMOS passgate ( 50,12 )

//* Define device -- nmos nchpd_lpgdpsr
NOT ngate_sdplpg SRAMPSGT ngate_spdlpgdp; //  SRAM LPG NMOS pulldown ( 50,12 )

//* Define device -- nmos nchpg_hvtdpsr
AND ngate_s7 VTH_N ngate_hvsdp1;
NOT ngate_hvsdp1 SRM_ULL ngate_hvsdp;
AND ngate_hvsdp SRAMPSGT ngate_hvspgdp; //  SRAM High VT NMOS passgate ( 50,12 )

//* Define device -- nmos nchpd_hvtdpsr
NOT ngate_hvsdp SRAMPSGT ngate_hvspddp; //  SRAM High VT NMOS pulldown ( 50,12 )

//* Define device -- nmos nchpg_dphcsr
AND ngate_s63 SRM13 ngate_s8;
NOT ngate_s8 VTH_N ngate_sdphc;
AND ngate_sdphc SRAMPSGT ngate_spgdphc; //  SRAM NMOS passgate ( 50,13 )

//* Define device -- nmos nchpd_dphcsr
NOT ngate_sdphc SRAMPSGT ngate_spddphc; //  SRAM NMOS pulldown ( 50,13 )

//* Define device -- nmos nchpg_hvtdphcsr
AND ngate_s8 VTH_N ngate_hvsdphc;
AND ngate_hvsdphc SRAMPSGT ngate_hvspgdphc; //  SRAM High VT NMOS passgate ( 50,13 )

//* Define device -- nmos nchpd_hvtdphcsr
NOT ngate_hvsdphc SRAMPSGT ngate_hvspddphc; //  SRAM High VT NMOS pulldown ( 50,13 )

//* Define device -- nmos nchpg_wosr
AND ngate_s63 SRM16 ngate_s9;
NOT ngate_s9 VTH_N ngate_swo1; //  For N65 G SRAM
AND ngate_s_org2 LPSRM11 ngate_swo2; //  For N65 LP SRAM
OR ngate_swo1 ngate_swo2 ngate_swo; //  wosr =  (50;16) || (50;11)
AND ngate_swo SRAMPSGT ngate_spgwo; //  SRAM NMOS passgate ( 50,16 ) of G + ( 50,11 ) of LP

//* Define device -- nmos nchpd_wosr
NOT ngate_swo SRAMPSGT ngate_spdwo; //  SRAM NMOS pulldown ( 50,16 ) of G + ( 50,11 ) of LP

//* Define device -- nmos nchpg_wisr
NOT ngate_s_org1 LPSRM11 ngate_swi1;
AND ngate_swi1 LPSRM10 ngate_swi; //  For N65 LP SRAM
AND ngate_swi SRAMPSGT ngate_spgwi; //  SRAM NMOS passgate ( 50,10 ) of LP

//* Define device -- nmos nchpd_wisr
NOT ngate_swi SRAMPSGT ngate_spdwi; //  SRAM NMOS pulldown ( 50,10 ) of LP

//* Define device -- pmos pchpu_wosr
AND pgate_s_org2 LPSRM11 pgate_swo; //  SRAM PMOS ( 50,11 ) of N65LP

//* Define device -- pmos pchpu_wisr
NOT pgate_s_org1 LPSRM11 pgate_swi1;
AND pgate_swi1 LPSRM10 pgate_swi; //  SRAM PMOS ( 50,10 ) of N65LP

//* Define device -- nmos nchpg_ulpsr
AND ngate_s62 SRM17 ngate_s10;
NOT ngate_s10 SRM12 ngate_s11;
AND ngate_s11 VTH_N ngate_sulp;
AND ngate_sulp SRAMPSGT ngate_spgulp; //  SRAM ULP NMOS passgate ( 50,17 ) 

//* Define device -- nmos nchpd_ulpsr
NOT ngate_sulp SRAMPSGT ngate_spdulp; //  SRAM ULP NMOS pulldown ( 50,17 )

//* Define device -- nmos nchpg_ulpdpsr
AND ngate_s10 SRM12 ngate_s12;
AND ngate_s12 VTH_N ngate_sdpulp;
AND ngate_sdpulp SRAMPSGT ngate_spgulpdp; //  SRAM ULP NMOS passgate ( 50,17 ) ( 50,12 ) 

//* Define device -- nmos nchpd_ulpdpsr
NOT ngate_sdpulp SRAMPSGT ngate_spdulpdp; //  SRAM ULP NMOS pulldown ( 50,17 ) ( 50,12 )

//* Define device -- nmos nchpg_lpgtpsr
AND ngate_s61 SRM14 ngate_s13;
NOT ngate_s13 VTH_N ngate_stp_org;
AND ngate_stp_org DCO ngate_stplpg;
AND ngate_stplpg SRAMPSGT ngate_spglpgtp; //  SRAM LPG NMOS passgate ( 50,14 )

//* Define device -- nmos nchpd_lpgtpsr
NOT ngate_stplpg SRAMPSGT ngate_spdlpgtp; //  SRAM LPG NMOS pulldown ( 50,14 )

//* Define device -- nmos nch_18
AND tngate1 OD18 ngate_18a1;
COPY ngate_18a1 ngate_18a;
NOT ngate_18a NT_Ni ngate_18b;
NOT ngate_18b DNW ngate_18c;
NOT ngate_18c VTL_N ngate_18_org11;
COPY ngate_18_org11 ngate_18_org1;
SELECT -INTERACT ngate_18_org1 RH -NOT ngate_18_org;
NOT ngate_18_org MAC ngate_18; //  1.8v NMOS

//* Define device -- nmos nch_18_dnw
AND ngate_18b DNW dngate_18a;
NOT dngate_18a VTL_N dngate_18_org1;
SELECT -INTERACT dngate_18_org1 RH -NOT dngate_18_org;
NOT dngate_18_org MAC dngate_18; //  1.8v NMOS on DNW

//* Define device -- nmos nch_18_mac
AND ngate_18_org MAC ngate_18_mac; //  1.8v NMOS MAC

//* Define device -- nmos nch_18_dnw_mac
AND dngate_18_org MAC dngate_18_mac; //  1.8v NMOS on DNW MAC

//* Define device -- nmos nch_esd18
SELECT -INTERACT ngate_18_org1 RH ngate_esd18_org1 ;
SELECT -INTERACT ngate_esd18_org1 RPO ngate_esd18_org ;
NOT ngate_esd18_org MAC ngate_esd18; //  1.8v esd non-LDD NMOS

//* Define device -- nmos nch_esd18_dnw
SELECT -INTERACT dngate_18_org1 RH dngate_esd18_org1 ;
SELECT -INTERACT dngate_esd18_org1 RPO dngate_esd18_org ;
NOT dngate_esd18_org MAC dngate_esd18; //  1.8v esd non-LDD NMOS on DNW

//* Define device -- nmos nch_esd18_mac
AND ngate_esd18_org MAC ngate_esd18_mac; //  1.8v esd non-LDD NMOS MAC

//* Define device -- nmos nch_esd18_dnw_mac
AND dngate_esd18_org MAC dngate_esd18_mac; //  1.8v esd non-LDD NMOS on DNW MAC

//* Define device -- nmos nch_25
AND tngate1 OD25 ngate_25a1;
COPY ngate_25a1 ngate_25a;
NOT ngate_25a NT_Ni ngate_25b;
NOT ngate_25b DNW ngate_25c1;
NOT ngate_25c1 CELLM ngate_25c2; //  exclude CIS MVT NMOS
NOT ngate_25c2 CAP_IMP ngate_25c; //  exclude CIS npolycap
SELECT -INTERACT ngate_25c HVD_NW -NOT ngate_25e;
NOT ngate_25e VTL_N ngate_25_org1;
COPY ngate_25_org1 ngate_25_org;
AND ngate_25_org OD25_18 ngate_25ud1;
NOT ngate_25_org ngate_25ud1 ngate_25z;
AND ngate_25_org OD25_33 ngate_25od1;
NOT ngate_25z ngate_25od1 ngate_25y;
AND ngate_25_org OD25_28 ngate_25od281;
NOT ngate_25y ngate_25od281 ngate_25x;
NOT ngate_25x MAC ngate_25; //  2.5v NMOS

//* Define device -- nmos nch_25_dnw
AND ngate_25b DNW dngate_25a1;
NOT dngate_25a1 HVD_DPW dngate_25a;
NOT dngate_25a CELLM dngate_25b;
NOT dngate_25b CAP_IMP dngate_25c;
NOT dngate_25c VTL_N dngate_25_org1;
COPY dngate_25_org1 dngate_25_org;
AND dngate_25_org OD25_18 dngate_25ud1;
NOT dngate_25_org dngate_25ud1 dngate_25z;
AND dngate_25_org OD25_33 dngate_25od1;
NOT dngate_25z dngate_25od1 dngate_25y;
AND dngate_25_org OD25_28 dngate_25od281;
NOT dngate_25y dngate_25od281 dngate_25x;
NOT dngate_25x MAC dngate_25; //  2.5v NMOS on DNW

//* Define device -- nmos nch_25_mac
AND ngate_25x MAC ngate_25_mac; //  2.5v NMOS MAC

//* Define device -- nmos nch_25_dnw_mac
AND dngate_25x MAC dngate_25_mac; //  2.5v NMOS on DNW MAC

//* Define device -- nmos nch_25ud
NOT ngate_25ud1 MAC ngate_25ud; //  2.5v NMOS under_drive 1.8v

//* Define device -- nmos nch_25_dnwud
NOT dngate_25ud1 MAC dngate_25ud; //  2.5v NMOS on DNW under_drive 1.8v

//* Define device -- nmos nch_25ud_mac
AND ngate_25ud1 MAC ngate_25ud_mac; //  2.5v NMOS under_drive 1.8v MAC

//* Define device -- nmos nch_25_dnwud_mac
AND dngate_25ud1 MAC dngate_25ud_mac; //  2.5v NMOS on DNW under_drive 1.8v MAC

//* Define device -- nmos nch_25od
NOT ngate_25od1 MAC ngate_25od; //  2.5v NMOS over_drive 3.3v

//* Define device -- nmos nch_25_dnwod
NOT dngate_25od1 MAC dngate_25od; //  2.5v NMOS on DNW over_drive 3.3v

//* Define device -- nmos nch_25od_mac
AND ngate_25od1 MAC ngate_25od_mac; //  2.5v NMOS over_drive 3.3v MAC

//* Define device -- nmos nch_25_dnwod_mac
AND dngate_25od1 MAC dngate_25od_mac; //  2.5v NMOS on DNW over_drive 3.3v MAC

//* Define device -- lddn nch_hv25_snw
SELECT -INTERACT ngate_25c HVD_NW ngate_25hvdw_org1 ; //  HVD NMOS NW
NOT ngate_25hvdw_org1 HVD_DPW ngate_25hvdw_org;
NOT ngate_25hvdw_org MAC ngate_25hvdw; //  HVD NMOS by NW approach

//***** Define connectivity/via layer -- s_nd25hvdw ****
NOT tndiff_ori HVD_NW s_nd25hvdw1;
NOT s_nd25hvdw1 HVD_DPW s_nd25hvdw2;
SELECT -INTERACT s_nd25hvdw2 ngate_25hvdw_org s_nd25hvdw ;

//* Define device -- lddn nch_hv25_snw_mac
AND ngate_25hvdw_org MAC ngate_25hvdw_mac; //  HVD MACRO NMOS by NW approach

//* Define device -- lddp pch_hv25_spw
AND tpgate1 OD25 pgate_25a1;
NOT pgate_25a1 MEDP pgate_25a; //  exclude CIS MVT PMOS 
SELECT -INTERACT pgate_25a HVD_P pgate_25hvd_org ; //  HVD PMOS
NOT pgate_25hvd_org MAC pgate_25hvd;

//***** Define connectivity/via layer -- s_pd25hvd ****
NOT tpdiff_ori HVD_P s_pd25hvd1;
SELECT -INTERACT s_pd25hvd1 pgate_25hvd_org s_pd25hvd ;

//* Define device -- lddp pch_hv25_spw_mac
AND pgate_25hvd_org MAC pgate_25hvd_mac;

//* Define device -- nmos nch_33
AND tngate1 OD33 ngate_33a1;
COPY ngate_33a1 ngate_33a;
NOT ngate_33a NT_Ni ngate_33b;
NOT ngate_33b DNW ngate_33c;
NOT ngate_33c VTL_N ngate_33_org11;
COPY ngate_33_org11 ngate_33_org1;
NOT ngate_33_org1 CAP_IMP ngate_33_org2;
NOT ngate_33_org2 CELLM ngate_33_org;
NOT ngate_33_org MAC ngate_33; //  3.3v NMOS

//* Define device -- nmos nch_33_dnw
AND ngate_33b DNW dngate_33a;
NOT dngate_33a VTL_N dngate_33_org1;
COPY dngate_33_org1 dngate_33_org2;
NOT dngate_33_org2 CAP_IMP dngate_33_org3;
NOT dngate_33_org3 CELLM dngate_33_org;
NOT dngate_33_org MAC dngate_33; //  3.3v NMOS on DNW

//* Define device -- nmos nch_33_mac
AND ngate_33_org MAC ngate_33_mac; //  3.3v NMOS MAC

//* Define device -- nmos nch_33_dnw_mac
AND dngate_33_org MAC dngate_33_mac; //  3.3v NMOS on DNW MAC

//* Define device -- nmos nch_na25
AND ngate_25a NT_Ni ngate_25na1;
NOT ngate_25na1 VTL_N ngate_25na2;
COPY ngate_25na2 ngate_25na3;
NOT ngate_25na3 DNW ngate_25na4;
NOT ngate_25na4 CAP_IMP ngate_25na_org; //  exclude cis npolycap
AND ngate_25na_org OD25_18 ngate_25naud1;
NOT ngate_25na_org ngate_25naud1 ngate_25naz;
AND ngate_25na_org OD25_33 ngate_25naod1;
NOT ngate_25naz ngate_25naod1 ngate_25nay;
NOT ngate_25nay MAC ngate_25na; //  2.5v Native NMOS

//* Define device -- nmos nch_na25_mac
AND ngate_25nay MAC ngate_25na_mac; //  2.5v Native NMOS MAC

//* Define device -- nmos nch_na25ud
NOT ngate_25naud1 MAC ngate_25naud; //  2.5v Native NMOS under_drive 1.8v

//* Define device -- nmos nch_na25ud_mac
AND ngate_25naud1 MAC ngate_25naud_mac; //  2.5v Native NMOS under_drive 1.8v MAC

//* Define device -- nmos nch_na25od
NOT ngate_25naod1 MAC ngate_25naod; //  2.5v Native NMOS over_drive 3.3v

//* Define device -- nmos nch_na25od_mac
AND ngate_25naod1 MAC ngate_25naod_mac; //  2.5v Native NMOS over_drive 3.3v MAC

//* Define device -- nmos nch_na18
AND ngate_18a NT_Ni ngate_18na1;
NOT ngate_18na1 VTL_N ngate_18na2;
NOT ngate_18na2 DNW ngate_18na_org;
NOT ngate_18na_org MAC ngate_18na; //  1.8v Native NMOS

//* Define device -- nmos nch_na18_mac
AND ngate_18na_org MAC ngate_18na_mac; //  1.8v Native NMOS MAC

//* Define device -- nmos nch_na33
AND ngate_33a NT_Ni ngate_33na1;
NOT ngate_33na1 VTL_N ngate_33na2;
COPY ngate_33na2 ngate_33na3;
NOT ngate_33na3 DNW ngate_33na_org1;
NOT ngate_33na_org1 CAP_IMP ngate_33na_org;
NOT ngate_33na_org MAC ngate_33na; //  3.3v Native NMOS

//* Define device -- nmos nch_na33_mac
AND ngate_33na_org MAC ngate_33na_mac; //  3.3v Native NMOS MAC

//* Define device -- nmos nch_25od28
NOT ngate_25od281 MAC ngate_25od28; //  2.5v NMOS over_drive 2.8v

//* Define device -- nmos nch_25od28_mac
AND ngate_25od281 MAC ngate_25od28_mac; //  2.5v NMOS over_drive 2.8v MAC

//* Define device -- nmos nch_25od28_dnw
NOT dngate_25od281 MAC dngate_25od28; //  2.5v NMOS on DNW over_drive 2.8v

//* Define device -- nmos nch_25od28_dnw_mac
AND dngate_25od281 MAC dngate_25od28_mac; //  2.5v NMOS on DNW over_drive 2.8v MAC

//* Define device -- pmos pch_25od28
SELECT -INTERACT pgate_25a HVD_P -NOT pgate_25b;
NOT pgate_25b VTL_P pgate_25_org1;
COPY pgate_25_org1 pgate_25_org;
AND pgate_25_org OD25_28 pagte_25od281;
NOT pagte_25od281 MAC pgate_25od28; //  2.5v PMOS over_drive 2.8v

//* Define device -- pmos pch_25od28_mac
AND pagte_25od281 MAC pgate_25od28_mac; //  2.5v PMOS over_drive 2.8v

//* Define device -- pmos pch_hvt
NOT phvgate2 EHVT_P phvgate_org1;
NOT phvgate_org1 ELVT_P phvgate_org;
NOT phvgate_org MAC phvgate; //  CORE HIGH_VT PMOS

//* Define device -- pmos pch_hvt_mac
AND phvgate_org MAC phvgate_mac; //  CORE HIGH_VT PMOS MAC

//* Define device -- pmos pch_uhvt
COPY puhvgate_org1 puhvgate_org;
NOT puhvgate_org MAC puhvgate; //  CORE ULTRA High VT PMOS

//* Define device -- pmos pch_uhvt_mac
AND puhvgate_org MAC puhvgate_mac; //  CORE ULTRA High VT PMOS MAC

//* Define device -- pmos pch_ulvt
COPY puvgate_org1 puvgate_org;
NOT puvgate_org MAC puvgate; //  CORE ULTRA LOW VT PMOS

//* Define device -- pmos pch_ulvt_mac
AND puvgate_org MAC puvgate_mac; //  CORE ULTRA LOW VT PMOS MAC

//* Define device -- pmos pch_lpg
AND pgate5 DCO pgatelpg1;
NOT pgatelpg1 VTH_P pgatelpg; //  CORE LPG PMOS

//* Define device -- pmos pch_lpghvt
AND phvgate1 DCO phvgatelpg; //  CORE HIGH_VT LPG PMOS

//* Define device -- pmos pch_w
AND tpgate4 OD1T pgate_1ta;
NOT pgate_1ta VTL_P pgate_1tb1;
COPY pgate_1tb1 pgate_1tb;
NOT pgate_1tb VTH_P pgate_1tc;
NOT pgate_1tc VTUL_P pgate_1td;
NOT pgate_1td CAP1TDMY pgate_1te;
SELECT -INTERACT pgate_1te p3 -NOT pgate_w1t; //  eDRAM pch_w   device

//* Define device -- pmos pch_w_lvt
AND pgate_1tc VTUL_P pgate_1tf;
NOT pgate_1tf CAP1TDMY pgate_1tg;
SELECT -INTERACT pgate_1tg p3 -NOT pgate_w1t_lvt; //  eDRAM pch_w_lvt device 

//* Define device -- pmos pch_edc
SELECT -INTERACT pgate_1te p3 pgate_1tr ; //  eDRAM pch_edc device

//* Define device -- pmos pchpu_lpgsr
AND pgate_s_org DCO pgate_slpg; //  SRAM LPG PMOS

//* Define device -- pmos pchpu_hvtsr
AND pgate_s6 VTH_P pgate_hvs1; //  SRAM High VT PMOS
NOT pgate_hvs1 SRM_ULL pgate_hvs; //  SRAM High VT PMOS

//* Define device -- pmos pch_timer
AND pgate_s612 SRAMTIMER pgate_st;

//* Define device -- pmos pchpu_lpgdpsr
AND pgate_sdp_org DCO pgate_sdplpg; //  SRAM LPG PMOS( 50,12 )

//* Define device -- pmos pchpu_hvtdpsr
NOT pgate_s7 SRM_ULL pgate_hvsdp1;
AND pgate_hvsdp1 VTH_P pgate_hvsdp; //  SRAM High VT PMOS( 50,12 )

//* Define device -- pmos pchpu_dphcsr
AND pgate_s63 SRM13 pgate_s8;
NOT pgate_s8 VTH_P pgate_sdphc; //  SRAM PMOS( 50,13 )

//* Define device -- pmos pchpu_hvtdphcsr
AND pgate_s8 VTH_P pgate_hvsdphc; //  SRAM High VT PMOS( 50,13 )

//* Define device -- pmos pchpu_ulpsr
AND pgate_s62 SRM17 pgate_s10;
NOT pgate_s10 SRM12 pgate_s11;
AND pgate_s11 VTH_P pgate_sulp; //  SRAM ULP PMOS( 50,17 )

//* Define device -- pmos pchpu_ulpdpsr
AND pgate_s10 SRM12 pgate_s12;
AND pgate_s12 VTH_P pgate_sdpulp; //  SRAM ULP PMOS( 50,17 ) ( 50,12 )  

//* Define device -- pmos pchpu_lpgtpsr
AND pgate_s61 SRM14 pgate_s13;
NOT pgate_s13 VTH_P pgate_stp_org;
AND pgate_stp_org DCO pgate_stplpg; //  SRAM LPG PMOS( 50,14 )

//* Define device -- pmos pch_18
AND tpgate1 OD18 pgate_18a;
NOT pgate_18a VTL_P pgate_18_org1;
COPY pgate_18_org1 pgate_18_org;
NOT pgate_18_org MAC pgate_18; //  1.8v PMOS

//* Define device -- pmos pch_18_mac
AND pgate_18_org MAC pgate_18_mac; //  1.8v PMOS MAC

//* Define device -- pmos pch_25
AND pgate_25_org OD25_18 pgate_25ud1;
NOT pgate_25_org pgate_25ud1 pgate_25z;
AND pgate_25_org OD25_33 pgate_25od1;
NOT pgate_25z pgate_25od1 pgate_25y;
NOT pgate_25y pagte_25od281 pgate_25x;
NOT pgate_25x MAC pgate_25; //  2.5v PMOS

//* Define device -- pmos pch_25_mac
AND pgate_25x MAC pgate_25_mac; //  2.5v PMOS MAC

//* Define device -- pmos pch_25ud
NOT pgate_25ud1 MAC pgate_25ud; //  2.5v PMOS under_drive 1.8v

//* Define device -- pmos pch_25ud_mac
AND pgate_25ud1 MAC pgate_25ud_mac; //  2.5v PMOS under_drive 1.8v MAC

//* Define device -- pmos pch_25od
NOT pgate_25od1 MAC pgate_25od; //  2.5v PMOS over_drive 3.3v

//* Define device -- pmos pch_25od_mac
AND pgate_25od1 MAC pgate_25od_mac; //  2.5v PMOS over_drive 3.3v MAC

//* Define device -- pmos pch_33
AND tpgate1 OD33 pgate_33a;
NOT pgate_33a VTL_P pgate_33_org1;
COPY pgate_33_org1 pgate_33_org;
NOT pgate_33_org MAC pgate_33; //  3.3v PMOS

//* Define device -- pmos pch_33_mac
AND pgate_33_org MAC pgate_33_mac; //  3.3v PMOS MAC

//* Define device -- diode pdio
AND tpdiff DIODMY pdio1a;
NOT pdio1a HIADMY pdio1c;
NOT pdio1c DIO3TDMY pdio1;
AND pdio1 nxwell pdio2a;
NOT pdio2a HVNW pdio2;
NOT pdio2 OD25 pdio3;
NOT pdio3 OD33 pdio4;
NOT pdio4 OD18 pdio5;
NOT pdio5 VTL_P pdio8;
NOT pdio8 UHVT_P pdio9;
NOT pdio9 EHVT_P pdio10;
NOT pdio10 ELVT_P pdio11;
NOT pdio11 VTH_P cpdio1;
NOT cpdio1 VTL_P cpdio2;
NOT cpdio2 ILVT cpdio3;
NOT cpdio3 DCO cpdio4;
NOT cpdio4 OD1T cpdio6;
NOT cpdio6 OD6 cpdio7;
NOT cpdio7 OD5 cpdio; //  CORE P+/NW DIODE

//* Define device -- diode ndio
AND tndiff DIODMY ndio1a;
NOT ndio1a HIADMY ndio1;
AND ndio1 psub ndio2a;
NOT ndio2a HVNW ndio2b;
NOT ndio2b HVPW ndio2c;
NOT ndio2c HVPSUB ndio2;
NOT ndio2 OD25 ndio3;
NOT ndio3 OD33 ndio4;
NOT ndio4 OD18 ndio5;
NOT ndio5 NT_Ni ndio6;
NOT ndio6 VTL_N ndio9;
NOT ndio9 UHVT_N ndio10;
NOT ndio10 EHVT_N ndio11;
NOT ndio11 ELVT_N ndio12;
NOT ndio12 VTH_N cndio1;
NOT cndio1 VTL_N cndio2;
NOT cndio2 ILVT cndio3;
NOT cndio3 DCO cndio4;
NOT cndio4 OD1T cndio6;
NOT cndio6 OD5 cndio7;
NOT cndio7 OD6 cndio; //  CORE N+/PW DIODE

//* Define device -- diode ndio_lvt
NOT ndio6 OD5 ndio6a;
AND ndio6a VTL_N ndiol; //  CORE N+/PW LOW_VT DIODE

//* Define device -- diode pdio_lvt
NOT pdio5 OD5 pdio5a;
AND pdio5a VTL_P pdiol; //  CORE P+/NW LOW_VT DIODE

//* Define device -- diode ndio_cehv
NOT ndio2b HVNW ndio2_1;
AND ndio2_1 HVPSUB ndio2_2;
AND ndio2_2 HVPW hv_ndio; //  HVN DIODE

//* Define device -- diode pdio_cehv
AND pdio1 HVNW hv_pdio1;
NOT hv_pdio1 HVPW hv_pdio2;
NOT hv_pdio2 HVPSUB hv_pdio;

//* Define device -- diode zdio_cehv
NOT ndio2_2 HVPW hv_zdio; //  HVZ DIODE

//* Define device -- diode pdio_lpg
AND cpdio3 DCO cpdio5;
NOT cpdio5 OD1T cpdiolpg; //  CORE P+/NW LPG DIODE

//* Define device -- diode ndio_lpg
AND cndio3 DCO cndio5;
NOT cndio5 OD1T cndiolpg; //  CORE N+/PW LPG DIODW

//* Define device -- diode pdio_w
AND cpdio4 OD1T epdio; //  eDRAM P+/NW DIODE

//* Define device -- diode ndio_w
AND cndio4 OD1T endio; //  eDRAM N+/PW DIODE

//* Define device -- diode nwdio
SELECT -OUTSIDE DIODMY tpdiff DIONW ;
AND nxwell DIONW nwdio1;
COPY nwdio1 cnwdio;

//* Define device -- diode pdio_hvt
NOT pdio5 DCO pdio6;
AND pdio6 VTH_P pdio61;
NOT pdio61 EHVT_P pdioh1;
NOT pdioh1 ELVT_P pdioh; //  CORE P+/NW HIGH_VT DIODE

//* Define device -- diode pdio_lpghvt
AND pdio5 DCO pdio7;
AND pdio7 VTH_P pdiohlpg; //  CORE P+/NW HIGH_VT LPG DIODE

//* Define device -- diode ndio_hvt
NOT ndio6 DCO ndio7;
AND ndio7 VTH_N ndio71;
NOT ndio71 EHVT_N ndioh1;
NOT ndioh1 ELVT_N ndioh; //  CORE N+/PW HIGH_VT DIODE

//* Define device -- diode ndio_lpghvt
AND ndio6 DCO ndio8; //  CORE N+/PW HIGH_VT LPG DIODE
AND ndio8 VTH_N ndiohlpg; //  CORE N+/PW HIGH_VT LPG DIODE

//* Define device -- diode pdio_mlvt
AND cpdio2 ILVT pdioilvt; //  LP PDIO MLVD DIODE

//* Define device -- diode ndio_mlvt
AND cndio2 ILVT cndioilvt; //  CORE LP N+/PW MLVT DIODE

//* Define device -- diode pdio_uhvt
AND pdio8 UHVT_P pdiouh;

//* Define device -- diode ndio_uhvt
AND ndio9 UHVT_N ndiouh;

//* Define device -- diode pdio_18
AND pdio2 OD18 ipdio_18; //  1.8v P+/NW DIODE

//* Define device -- diode ndio_18
AND ndio2 OD18 ndio_18a;
NOT ndio_18a NT_Ni indio_18; //  1.8v N+/PW diode

//* Define device -- diode pdio_25
AND pdio2 OD25 ipdio_25_org1;
NOT ipdio_25_org1 MEDP ipdio_25_org2; //  exclude cis mvt pdio
SELECT -INTERACT ipdio_25_org2 HVD_P -NOT ipdio_25_org;
NOT ipdio_25_org OD25_18 ipdio_25z;
NOT ipdio_25z OD25_33 ipdio_25y;
NOT ipdio_25y OD25_28 ipdio_25; //  2.5v P+/NW DIODE

//* Define device -- diode ndio_25
AND ndio2 OD25 ndio_25a1;
NOT ndio_25a1 CELLM ndio_25a; //  exclude cis mvt ndio
SELECT -INTERACT ndio_25a HVD_NW -NOT ndio_25c;
NOT ndio_25c NT_Ni indio_25_org; //  2.5v N+/PW diode
NOT indio_25_org OD25_18 indio_25z;
NOT indio_25z OD25_33 indio_25y;
NOT indio_25y OD25_28 indio_25; //  2.5v N+/PW DIODE

//* Define device -- diode pdio_25ud
AND ipdio_25_org OD25_18 ipdio_25ud; //  2.5v P+/NW DIODE under_drive 1.8v

//* Define device -- diode ndio_25ud
AND indio_25_org OD25_18 indio_25ud; //  2.5v N+/PW DIODE under_drive 1.8v

//* Define device -- diode pdio_25od
AND ipdio_25_org OD25_33 ipdio_25od; //  2.5v P+/NW DIODE under_drive 3.3v

//* Define device -- diode ndio_25od
AND indio_25_org OD25_33 indio_25od; //  2.5v N+/PW DIODE onder_drive 3.3v

//* Define device -- diode pdio_25od28
AND ipdio_25_org OD25_28 ipdio_25od28; //  2.5v P+/NW DIODE under_drive 2.8v

//* Define device -- diode ndio_25od28
AND indio_25_org OD25_28 indio_25od28; //  2.5v N+/PW DIODE onder_drive 2.8v

//* Define device -- diode pdio_33
AND pdio2 OD33 ipdio_33; //  3.3v P+/NW DIODE

//* Define device -- diode ndio_33
AND ndio2 OD33 ndio_33a;
NOT ndio_33a NT_Ni indio_33; //  3.3v N+/PW diode

//* Define device -- diode ndio_na
AND ndio5 NT_Ni nndio1;
NOT nndio1 VTH_N cndion1;
NOT cndion1 UHVT_N cndion2;
NOT cndion2 DCO cndion3;
NOT cndion3 VTL_N cndion;

//* Define device -- diode ndio_lpgna
AND cndion2 DCO cndion4;
NOT cndion4 VTL_N cndionlpg; //  CORE N+/PW Native LPG DIODE

//* Define device -- diode ndio_na18
AND ndio_18a NT_Ni ndio_18na; //  1.8v N+/PW native diode

//* Define device -- diode ndio_na25
AND ndio_25c NT_Ni ndio_25na_org;
NOT ndio_25na_org OD25_18 ndio_25naz;
NOT ndio_25naz OD25_33 ndio_25na; //  2.5v N+/PW native diode

//* Define device -- diode ndio_na25ud
AND ndio_25na_org OD25_18 ndio_25naud; //  2.5v N+/PW native diode under_drive 1.8v

//* Define device -- diode ndio_na25od
AND ndio_25na_org OD25_33 ndio_25naod; //  2.5v N+/PW native diode over_drive 3.3v

//* Define device -- diode ndio_na33
AND ndio_33a NT_Ni ndio_33na; //  3.3v N+/PW native diode

//***** Define connectivity/via layer -- ydio_hole ****
HOLES ydio ydio_hole;

//* Define device -- bjt pnp10
AND tpdiff BJTDMY ttdiff;
SELECT -INTERACT nxwell DNW -NOT nbase1k;
AND nbase1k BJTDMY nbase1;
NOT nbase1 OD25 cnbase1; //  define CORE BJT[PV] base terminal
AND ttdiff cnbase1 cemit1a; //  define CORE BJT[PV] emitter
SELECT -INTERACT cemit1a RPO cemit1 ; //  emitter need to interact RPO ring
AREA cemit1 -ltgt 99.999 100.001 cemit10_org;
NOT cemit10_org BJTDMY1 cemit10_orgi;
NOT cemit10_orgi MAC cemit10;

//***** Define connectivity/via layer -- coll1 ****
SELECT -TOUCH psub nbase1 collsur ;
OR collsur nbase1 coll1a; //  define both BJTs collector
AND DNW BJTDMY npnrg; //  define NPN region
AND tndiff npnrg nndiff;
AND psub npnrg pbase1;
NOT pbase1 OD25 cpbase1; //  define CORE BJT[NV] base terminal
AND nndiff cpbase1 cnemit1a; //  define CORE BJT[NV] emitter
SELECT -INTERACT cnemit1a RPO cnemit1 ; //  emitter need to interact RPO ring
SELECT -TOUCH collsur cnemit1 collsura ;
NOT coll1a collsura coll1b;
NOT coll1b cemit1 coll1; //   define pnp collector

//* Define device -- bjt pnp5
AREA cemit1 -ltgt 24.999 25.001 cemit5_org;
NOT cemit5_org BJTDMY1 cemit5_orgi;
NOT cemit5_orgi MAC cemit5;

//* Define device -- bjt pnp2
AREA cemit1 -ltgt 3.999 4.001 cemit2_org;
NOT cemit2_org BJTDMY1 cemit2_orgi;
NOT cemit2_orgi MAC cemit2;

//* Define device -- bjt npn10
AREA cnemit1 -ltgt 99.999 100.001 cnemit10_org;
NOT cnemit10_org BJTDMY1 cnemit10_orgi;
NOT cnemit10_orgi MAC cnemit10;

//***** Define connectivity/via layer -- ncoll1 ****
AND nxwell npnrg ncollrg;
SELECT -TOUCH ncollrg pbase1 ncolls ;
OR ncolls pbase1 ncoll1; //  define both BJTs collector

//* Define device -- bjt npn5
AREA cnemit1 -ltgt 24.999 25.001 cnemit5_org;
NOT cnemit5_org BJTDMY1 cnemit5_orgi;
NOT cnemit5_orgi MAC cnemit5;

//* Define device -- bjt npn2
AREA cnemit1 -ltgt 3.999 4.001 cnemit2_org;
NOT cnemit2_org BJTDMY1 cnemit2_orgi;
NOT cnemit2_orgi MAC cnemit2;

//* Define device -- bjt pnp10_s
AND cemit10_org BJTDMY1 cemit10_orgs;
NOT cemit10_orgs MAC cemit10s;

//* Define device -- bjt pnp5_s
AND cemit5_org BJTDMY1 cemit5_orgs;
NOT cemit5_orgs MAC cemit5s;

//* Define device -- bjt pnp2_s
AND cemit2_org BJTDMY1 cemit2_orgs;
NOT cemit2_orgs MAC cemit2s;

//* Define device -- bjt npn10_s
AND cnemit10_org BJTDMY1 cnemit10_orgs;
NOT cnemit10_orgs MAC cnemit10s;

//* Define device -- bjt npn5_s
AND cnemit5_org BJTDMY1 cnemit5_orgs;
NOT cnemit5_orgs MAC cnemit5s;

//* Define device -- bjt npn2_s
AND cnemit2_org BJTDMY1 cnemit2_orgs;
NOT cnemit2_orgs MAC cnemit2s;

//* Define device -- bjt pnp10_mis
AND cemit10_orgi MAC cemit10_mac;

//* Define device -- bjt pnp5_mis
AND cemit5_orgi MAC cemit5_mac;

//* Define device -- bjt pnp2_mis
AND cemit2_orgi MAC cemit2_mac;

//* Define device -- bjt npn10_mis
AND cnemit10_orgi MAC cnemit10_mac;

//* Define device -- bjt npn5_mis
AND cnemit5_orgi MAC cnemit5_mac;

//* Define device -- bjt npn2_mis
AND cnemit2_orgi MAC cnemit2_mac;

//* Define device -- bjt pnp10_s_mis
AND cemit10_orgs MAC cemit10s_mac;

//* Define device -- bjt pnp5_s_mis
AND cemit5_orgs MAC cemit5s_mac;

//* Define device -- bjt pnp2_s_mis
AND cemit2_orgs MAC cemit2s_mac;

//* Define device -- bjt npn10_s_mis
AND cnemit10_orgs MAC cnemit10s_mac;

//* Define device -- bjt npn5_s_mis
AND cnemit5_orgs MAC cnemit5s_mac;

//* Define device -- bjt npn2_s_mis
AND cnemit2_orgs MAC cnemit2s_mac;

//* Define device -- c CM
AND crown p3 mim_r1;
AND mim_r1 OD mim_r2;
SELECT -INTERACT mim_r2 RPO -NOT mim_r3;
SELECT -INTERACT mim_r3 blc mim_r ;

//* Define device -- c CM_decap
AND crown p3 mim_r4;
OR POI DPO POx;
COPY POx PO;
AND mim_r4 PO mim_r5;
AND mim_r5 EDRAM_DECAP mim_r6;
SELECT -INTERACT mim_r6 NP mim_r7 ;
SELECT -INTERACT mim_r7 blc mim_r_decap ;

//***** Define connectivity/via layer -- vargt ****
AND gatenw NP vargt1;
SELECT -INTERACT VAR RFDMY -NOT VAR_noRF;
AND vargt1 VAR_noRF vargt2;
NOT vargt2 OD18 vargt3;
NOT vargt3 OD25 vargt4;
NOT vargt4 DCO vargt5;
NOT vargt5 OD33 vargt7;
NOT vargt7 OD5 vargt7a;
NOT vargt7a OD6 vargt7b;
NOT vargt7b OD1T vargt; //  Varactor on thin oxide

//***** Define connectivity/via layer -- vargtlpg ****
AND vargt4 DCO vargt6;
NOT vargt6 OD33 vargtlpg; //  LPG Varactor on thin oxide

//***** Define connectivity/via layer -- vargt_25 ****
AND vargt2 OD25 vargt_25; //  Varactor on 2.5v thick oxide

//***** Define connectivity/via layer -- vargt_18 ****
AND vargt2 OD18 vargt_18; //  Varactor on 1.8v thick oxide

//***** Define connectivity/via layer -- vargt_33 ****
AND vargt2 OD33 vargt_33; //  Varactor on 3.3v thick oxide

//* Define device -- xdev rnwsti
AND NWDMY NW trwell; //  N-well resistor layer
AND diff RPO drpo;
NOT trwell drpo nwsti_r1; //  NWDMY*NW-RPO-diff --> nwsti
SELECT -INTERACT nwsti_r1 NWDMYi nwsti_r ; //  NWDMY*NW --> nwsti

//* Define device -- xdev rnwod
AND trwell drpo nwod_r1;
SELECT -INTERACT nwod_r1 NWDMYi nwod_r ; //  NWDMY*NW*RPO*diff --> nwod (2-Terminals)

//* Define device -- xdev rppolywo
AND rpolywo PP rppolywo_r1; //  P+POLY resistor w/o silicide
SELECT -INTERACT RPDMYi RFDMY -NOT RPDMYi_noRF;
SELECT -INTERACT rppolywo_r1 RPDMYi_noRF rppolywo_r ; //   P+POLY resistor w/o silicide (2-Terminals)

//* Define device -- xdev rnpolywo
AND rpolywo NP rnpolywo_r1; //  N+POLY resistor w/o silicide
SELECT -INTERACT rnpolywo_r1 RPDMYi_noRF rnpolywo_r ; //   N+POLY resistor w/o silicide (2-Terminals)

//* Define device -- xdev rpodwo
AND rodwo PP rpodwo_r11;
AND rpodwo_r11 NW rpodwo_r1;
SELECT -INTERACT rpodwo_r1 RPDMYi rpodwo_r ; //  P+OD resistor w/o silicide (2-Terminals)

//* Define device -- xdev rnodwo
AND rodwo NP rnodwo_r11;
NOT rnodwo_r11 NW rnodwo_r1;
SELECT -INTERACT rnodwo_r1 RPDMYi rnodwo_r ; //  N+OD resistor w/o silicide (2-Terminals)

//* Define device -- xdev rppolyl
AND rpoly PP rppoly; //  ALL P+POLY resistor w/i silicide
EDGE_BOOLEAN -INSIDE rppoly POI rppoly_edge
EDGE_LENGTH -ltge 2 99999999 rppoly_edge l_rppoly_eg;
SELECT -WITH_EDGE rppoly l_rppoly_eg l_rppoly 
SELECT -INTERACT l_rppoly RPDMYi_noRF rppolyl_r ; //  P+POLY resistor w/i silicide >=  2 (2-Terminals)

//* Define device -- xdev rnpolyl
AND rpoly NP rnpoly; //  ALL N+POLY resistor w/i silicide
EDGE_BOOLEAN -INSIDE rnpoly POI rnpoly_edge
EDGE_LENGTH -ltge 2 99999999 rnpoly_edge l_rnpoly_eg;
SELECT -WITH_EDGE rnpoly l_rnpoly_eg l_rnpoly 
SELECT -INTERACT l_rnpoly RPDMYi rnpolyl_r ; //  N+POLY resistor w/i silicide >=  2 (2-Terminals)

//* Define device -- xdev rpodl
AND rod PP rpod1; //  P+OD resistor w/i silicide
AND rpod1 NW rpod; //  P+OD resistor w/i silicide
EDGE_BOOLEAN -INSIDE rpod diff rpod_edge
EDGE_LENGTH -ltge 2 99999999 rpod_edge l_rpod;
SELECT -WITH_EDGE rpod l_rpod rpodl_r1 
SELECT -INTERACT rpodl_r1 RPDMYi rpodl_r ; //  P+OD resistor w/i silicide >= 2 (2-Terminals)

//* Define device -- xdev rnodl
AND rod NP rnod1; //  ALL N+OD resistor w/i silicide
NOT rnod1 NW rnod; //  ALL N+OD resistor w/i silicide
EDGE_BOOLEAN -INSIDE rnod diff rnod_edge
EDGE_LENGTH -ltge 2 99999999 rnod_edge l_rnod;
SELECT -WITH_EDGE rnod l_rnod rnodl_r1 
SELECT -INTERACT rnodl_r1 RPDMYi rnodl_r ; //  N+OD resistor w/i silicide >= 2  (2-Terminals)

//* Define device -- xdev rppolys
NOT rppoly l_rppoly s_rppoly;
SELECT -INTERACT s_rppoly RPDMYi_noRF rppolys_r ; //  P+POLY resistor w/i silicide < 2 (2-Terminals)

//* Define device -- xdev rnpolys
NOT rnpoly l_rnpoly s_rnpoly;
SELECT -INTERACT s_rnpoly RPDMYi rnpolys_r ; //  N+POLY resistor w/i silicide < 2 (2-Terminals)

//* Define device -- xdev rpods
NOT rpod rpodl_r1 rpods_r1;
SELECT -INTERACT rpods_r1 RPDMYi rpods_r ; //  P+OD resistor w/i silicide < 2 (2-Terminals)

//* Define device -- xdev rnods
NOT rnod rnodl_r1 rnods_r1;
SELECT -INTERACT rnods_r1 RPDMYi rnods_r ; //  N+OD resistor w/i silicide < 2  (2-Terminals)

//* Define device -- xdev rm1
OR M1 CO M1X;
OR M1X DUM1 M1Y;
AND M1Y RMDMY1 mt1res1;
SELECT -INTERACT mt1res1 M1 mt1res ; //  metal1 resistor

//***** Define connectivity/via layer -- metal1 ****
NOT M1Y mt1res metal1; //  metal1 interconnect

//* Define device -- xdev rm2
OR M2 DUM2 M2X;
OR IND_STD IND_SYM inddmy1;
OR inddmy1 IND_CT inddmy2;
OR inddmy2 IND_STD_MUA inddmy3;
OR inddmy3 IND_SYM_MUA inddmy4;
OR inddmy4 IND_CT_MUA inddmy5;
AND IND_NR RBCDMY IND_meander; //  Meander ind use (144;32) to be inddmy layer for RBC
OR inddmy5 IND_meander INDDMY;
NOT M2X INDDMY M2Y;
AND M2Y RMDMY2 mt2res1;
SELECT -INTERACT mt2res1 M2 mt2res ; //  metal2 resistor

//***** Define connectivity/via layer -- metal2 ****
NOT M2Y mt2res metal2; //  metal2 interconnect

//* Define device -- xdev rm3
OR M3 DUM3 M3X;
NOT M3X INDDMY M3Y;
AND M3Y RMDMY3 mt3res1;
SELECT -INTERACT mt3res1 M3 mt3res ; //  metal3 resistor

//***** Define connectivity/via layer -- metal3 ****
NOT M3Y mt3res metal3; //  metal3 interconnect

//* Define device -- xdev rm4
OR M4 DUM4 M4X;
NOT M4X INDDMY M4Y;
AND M4Y RMDMY4 mt4res1;
SELECT -INTERACT mt4res1 M4 mt4res ; //  metal4 resistor

//***** Define connectivity/via layer -- metal4 ****
NOT M4Y mt4res metal4; //  metal4 interconnect

//* Define device -- xdev rm5
OR M5 DUM5 M5X;
NOT M5X INDDMY M5Y;
AND M5Y RMDMY5 mt5res1;
SELECT -INTERACT mt5res1 M5 mt5res ; //  metal5 resistor

//***** Define connectivity/via layer -- metal5 ****
NOT M5Y mt5res metal5; //  metal5 interconnect

//* Define device -- xdev rm6
OR M6 DUM6 M6X;
NOT M6X INDDMY M6Y;
AND M6Y RMDMY6 mt6res1;
SELECT -INTERACT mt6res1 M6 mt6res ; //  metal6 resistor

//***** Define connectivity/via layer -- metal6 ****
NOT M6Y mt6res metal6; //  metal6 interconnect

//* Define device -- xdev rm7
OR M7 DUM7 M7X;
NOT M7X INDDMY M7Y;
AND M7Y RMDMY7 mt7res1;
SELECT -INTERACT mt7res1 M7 mt7res ; //  metal7 resistor

//***** Define connectivity/via layer -- metal7 ****
NOT M7Y mt7res metal7; //  metal7 interconnect

//* Define device -- xdev rm8
OR M8 DUM8 M8X;
NOT M8X INDDMY M8Y;
AND M8Y RMDMY8 mt8res1;
SELECT -INTERACT mt8res1 M8 mt8res ; //  metal8 resistor

//***** Define connectivity/via layer -- metal8 ****
NOT M8Y mt8res metal8; //  metal8 interconnect

//* Define device -- xdev rm9
OR M9 DUM9 M9X;
NOT M9X INDDMY M9Y;
AND M9Y RMDMY9 mt9res1;
SELECT -INTERACT mt9res1 M9 mt9res ; //  metal9 resistor

//***** Define connectivity/via layer -- metal9 ****
NOT M9Y mt9res metal9; //  metal9 interconnect

//* Define device -- xdev rm10
OR AP DAP APX;
NOT APX INDDMY M10Y;
AND M10Y RMDMYAP mtAPres1;
SELECT -INTERACT mtAPres1 AP mtAPres ; //  metalAP resistor

//***** Define connectivity/via layer -- metal10 ****
NOT M10Y mtAPres metal10; //  metalAP interconnect

//* Define device -- xdev rnwsti_m
SELECT -INTERACT nwsti_r1 NWDMY1 nwsti_mr ; //  NWDMY*NW --> nwsti (3-Terminals)

//* Define device -- xdev rnwod_m
SELECT -INTERACT nwod_r1 NWDMY1 nwod_mr ; //  NWDMY*NW*RPO*diff --> nwod (3-Terminals)

//* Define device -- xdev dnwpsub
SELECT -INTERACT nxwell DNW dnwdio_b ;
SELECT -INSIDE nxwell DNW dnwdio_a ;
NOT dnwdio_b dnwdio_a dnwdio_k;
SELECT -INTERACT DNW dnwdio_k dnwdio1 ;
OR RFDMY5T RFDMY6T rfdmy56;
NOT dnwdio1 rfdmy56 dnwdio;

//***** Define connectivity/via layer -- psub_term ****
NOT BULK psubband psub_term_b;
AND BULK DNW psub_term_c;
NOT BULK psub_term_c psub_term_d;
AND psub_term_b psub_term_d psub_term_e;
SELECT -INTERACT psub_term_e DNW psub_term ;

//* Define device -- xdev pwdnw
NOT DNW nxwell rwdio1;
SELECT -INTERACT rwdio1 BJTDMY -NOT rwdio2;
NOT rwdio2 rfdmy56 rwdio;

//* Define device -- xdev pnwdio
SELECT -OUTSIDE nxwell cnwdio pnwdio1 ; //  exclude nwdio device 
NOT pnwdio1 DNW pnwdio2a;
NOT pnwdio2a cnbase1 pnwdio2b; //  exclude PNP
SELECT -INTERACT pnwdio2b NWDMY1 -NOT pnwdio2c; //  exclude 3T NWRES
SELECT -INTERACT pnwdio2c HIADMY -NOT pnwdio2d; //  exclude HIA pdio
NOT pnwdio2d VAR pnwdio2e; //  exclude xjvar_nw and moscap_nw
NOT pnwdio2e SBDDMY pnwdio21; //  exclude schottky diode
NOT pnwdio21 SBD3TDMY pnwdio2;
SELECT -INSIDE psub DNW rwel ;
SELECT -INSIDE pnwdio1 rwel pnwdio3 ;
OR pnwdio2 pnwdio3 pnwdio4;
select -touch pnwdio4 psub -eq 1 pnwdio_r;

//* Define device -- xdev rppolywo_m
SELECT -INTERACT RPDMY1 RFDMY -NOT RPDMY1_noRF;
SELECT -INTERACT rppolywo_r1 RPDMY1_noRF rppolywo_d ; //   P+POLY resistor w/o silicide (3-Terminals)

//***** Define connectivity/via layer -- poly_term ****
AND POI RPDMY1 poly_term1;
SIZE poly_term1 -BY 0.005 poly_term2
NOT poly_term2 poly_term1 poly_term;

//* Define device -- xdev rnpolywo_m
SELECT -INTERACT rnpolywo_r1 RPDMY1_noRF rnpolywo_d ; //   N+POLY resistor w/o silicide (3-Terminals)

//* Define device -- xdev rppolyl_m
NOT l_rppoly rppolyl_r rppolyl_d1;
SELECT -INTERACT rppolyl_d1 RPDMY1_noRF rppolyl_d ; //  P+POLY resistor w/i silicide >=  2 (3-Terminals)

//* Define device -- xdev rnpolyl_m
NOT l_rnpoly rnpolyl_r rnpolyl_d1;
SELECT -INTERACT rnpolyl_d1 RPDMY1 rnpolyl_d ; //  N+POLY resistor w/i silicide >=  2 (3-Terminals)

//* Define device -- xdev rppolys_m
NOT s_rppoly rppolys_r rppolys_d1;
SELECT -INTERACT rppolys_d1 RPDMY1_noRF rppolys_d ; //  P+POLY resistor w/i silicide < 2 (3-Terminals)

//* Define device -- xdev rnpolys_m
NOT s_rnpoly rnpolys_r rnpolys_d1;
SELECT -INTERACT rnpolys_d1 RPDMY1 rnpolys_d ; //  N+POLY resistor w/i silicide < 2 (3-Terminals)

//* Define device -- xdev rpodwo_m
SELECT -INTERACT rpodwo_r1 RPDMY1 rpodwo_mr ; //  P+OD resistor w/o silicide (3-Terminals)

//* Define device -- xdev rnodwo_m
SELECT -INTERACT rnodwo_r1 RPDMY1 rnodwo_mr ; //  N+OD resistor w/o silicide (3-Terminals)

//* Define device -- xdev rpodl_m
SELECT -INTERACT rpodl_r1 RPDMY1 rpodl_mr ; //  P+OD resistor w/i silicide >= 2 (3-Terminals)

//* Define device -- xdev rnodl_m
SELECT -INTERACT rnodl_r1 RPDMY1 rnodl_mr ; //  N+OD resistor w/i silicide >= 2  (3-Terminals)

//* Define device -- xdev rpods_m
SELECT -INTERACT rpods_r1 RPDMY1 rpods_mr ; //  P+OD resistor w/i silicide < 2 (3-Terminals)

//* Define device -- xdev rnods_m
SELECT -INTERACT rnods_r1 RPDMY1 rnods_mr ; //  N+OD resistor w/i silicide < 2  (3-Terminals)

//* Define device -- xdev nmos_rf_mlvt
NOT gate_rf nxwell gate_rfnnw; //  gate_rf not inside nwell
AND gate_rfnnw NP ngate_rf1;
NOT ngate_rf1 NT_Ni ngate_rf2;
NOT ngate_rf2 OD2 ngate_rf3;
AND ngate_rf3 ILVT ngate_rfmlv; //  CORE RF MLVT nmos
SELECT -INTERACT nthin ngate_rfmlv ngate_nthin_mlv1 ;
SELECT -INSIDE ngate_nthin_mlv1 DNW ngate_nthin_mlv2 ;
NOT ngate_nthin_mlv2 RFDMY6T ngate_nthin_mlv; //  nmos_rf_mlvt

//* Define device -- xdev nmos_rf_mlvt_nodnw
SELECT -OUTSIDE ngate_nthin_mlv1 DNW ngate_nthin_mlvnodnw ; //  nmos_rf_mlvt_nodnw

//* Define device -- xdev pmos_rf_mlvt
AND gate_rf nxwell gate_rfnw; //  gate_rf inside nwell
AND gate_rfnw PP pgate_rf1;
NOT pgate_rf1 NT_Ni pgate_rf2;
NOT pgate_rf2 OD2 pgate_rf3;
AND pgate_rf3 ILVT pgate_rfmlv; //  CORE RF MLVT pmos gate
SELECT -INTERACT pthin pgate_rfmlv pgate_pthin_mlv1 ;
SELECT -INSIDE pgate_pthin_mlv1 DNW pgate_pthin_mlv2 ;
NOT pgate_pthin_mlv2 RFDMY5T pgate_pthin_mlv; //  pmos_rf_mlvt

//* Define device -- xdev pmos_rf_mlvt_nw
SELECT -OUTSIDE pgate_pthin_mlv1 DNW pgate_pthin_mlvnw1 ;
NOT pgate_pthin_mlvnw1 RFDMY5T pgate_pthin_mlvnw; //  pmos_rf_mlvt_nw

//* Define device -- xdev nmos_rf_mlvt_6t
AND ngate_nthin_mlv2 RFDMY6T ngate_nthin_mlv_6t; //  nmos_rf_mlvt_6t

//* Define device -- xdev pmos_rf_mlvt_5t
AND pgate_pthin_mlv2 RFDMY5T pgate_pthin_mlv_5t; //  pmos_rf_mlvt_5t

//* Define device -- xdev pmos_rf_mlvt_nw_5t
AND pgate_pthin_mlvnw1 RFDMY5T pgate_pthin_mlvnw_5t; //  pmos_rf_mlvt_nw_5t

//* Define device -- xdev nmos_rf
NOT ngate_rf3 VTH_N ngate_rfa;
NOT ngate_rfa VTL_N ngate_rfb;
NOT ngate_rfb ILVT ngate_rf; //  CORE RF nmos
SELECT -INTERACT nthin ngate_rf ngate_nthin1 ;
SELECT -INSIDE ngate_nthin1 DNW ngate_nthin2 ;
NOT ngate_nthin2 RDKDMY ngate_nthin3;
NOT ngate_nthin3 RFDMY6T ngate_nthin; //  nmos_rf

//* Define device -- xdev nmos_rf_rdk
AND ngate_nthin2 RDKDMY ngate_nthin_rdk1;
NOT ngate_nthin_rdk1 RFDMY6T ngate_nthin_rdk; //  nmos_rf_rdk

//* Define device -- xdev nmos_rf_nodnw
SELECT -OUTSIDE ngate_nthin1 DNW ngate_nthin_nodnw1 ;
NOT ngate_nthin_nodnw1 RDKDMY ngate_nthin_nodnw; //  nmos_rf_nodnw

//* Define device -- xdev nmos_rf_hvt
AND ngate_rf3 VTH_N ngate_rfhv; //  CORE RF HVT nmos
SELECT -INTERACT nthin ngate_rfhv ngate_nthin_hv1 ;
SELECT -INSIDE ngate_nthin_hv1 DNW ngate_nthin_hv2 ;
NOT ngate_nthin_hv2 RFDMY6T ngate_nthin_hv; //  nmos_rf_hvt

//* Define device -- xdev nmos_rf_hvt_nodnw
SELECT -OUTSIDE ngate_nthin_hv1 DNW ngate_nthin_hvnodnw ; //  nmos_rf_hvt_nodnw

//* Define device -- xdev nmos_rf_lvt
AND ngate_rf3 VTL_N ngate_rflv; //  CORE RF LVT nmos
SELECT -INTERACT nthin ngate_rflv ngate_nthin_lv1 ;
SELECT -INSIDE ngate_nthin_lv1 DNW ngate_nthin_lv2 ;
NOT ngate_nthin_lv2 RFDMY6T ngate_nthin_lv; //  nmos_rf_lvt

//* Define device -- xdev nmos_rf_lvt_nodnw
SELECT -OUTSIDE ngate_nthin_lv1 DNW ngate_nthin_lvnodnw ; //  nmos_rf_lvt_nodnw

//* Define device -- xdev nmos_rf_25
AND ngate_rf2 OD2 ngate_rfio1;
NOT ngate_rfio1 VTH_N ngate_rfio2;
NOT ngate_rfio2 VTL_N ngate_rfio3;
AND ngate_rfio3 OD25 ngate_rf_25a;
NOT ngate_rf_25a OD25_33 ngate_rf_25b;
NOT ngate_rf_25b OD25_18 ngate_rf_25c;
NOT ngate_rf_25c OD25_28 ngate_rf_25d;
SELECT -INTERACT ngate_rf_25d HVD_NW -NOT ngate_rf_25;
SELECT -INTERACT nthin ngate_rf_25 ngate_nthin_251 ;
SELECT -INSIDE ngate_nthin_251 DNW ngate_nthin_252 ;
NOT ngate_nthin_252 RFDMY6T ngate_nthin_25; //  nmos_rf_25

//* Define device -- xdev nmos_rf_25_nodnw
SELECT -OUTSIDE ngate_nthin_251 DNW ngate_nthin_25nodnw ; //  nmos_rf_25_nodnw

//* Define device -- xdev nmos_rf_25od
AND ngate_rf_25a OD25_33 ngate_rf_25od; //  RF 2.5v nmos over_drive 3.3v
SELECT -INTERACT nthin ngate_rf_25od ngate_nthin_253 ;
SELECT -INSIDE ngate_nthin_253 DNW ngate_nthin_254 ;
NOT ngate_nthin_254 RFDMY6T ngate_nthin_25od; //  nmos_rf_25od33 over_drive 3.3v

//* Define device -- xdev nmos_rf_25_nodnwod
SELECT -OUTSIDE ngate_nthin_253 DNW ngate_nthin_25nodnwod ; //  nmos_rf_25_nodnw over_drive 3.3v

//* Define device -- xdev nmos_rf_25ud
AND ngate_rf_25a OD25_18 ngate_rf_25ud; //  RF 2.5v nmos over_drive 1.8v
SELECT -INTERACT nthin ngate_rf_25ud ngate_nthin_255 ;
SELECT -INSIDE ngate_nthin_255 DNW ngate_nthin_256 ;
NOT ngate_nthin_256 RFDMY6T ngate_nthin_25ud; //  nmos_rf_25ud18  under_drive 1.8v

//* Define device -- xdev nmos_rf_25_nodnwud
SELECT -OUTSIDE ngate_nthin_255 DNW ngate_nthin_25nodnwud ; //  nmos_rf_25_nodnw under_drive 1.8v

//* Define device -- xdev nmos_rf_18
AND ngate_rfio3 OD18 ngate_rf_18; //  RF 1.8V nmos
SELECT -INTERACT nthin ngate_rf_18 ngate_nthin_181 ;
SELECT -INSIDE ngate_nthin_181 DNW ngate_nthin_182 ;
NOT ngate_nthin_182 RFDMY6T ngate_nthin_18; //  nmos_rf_18

//* Define device -- xdev nmos_rf_18_nodnw
SELECT -OUTSIDE ngate_nthin_181 DNW ngate_nthin_18nodnw ; //  nmos_rf_18_nodnw

//* Define device -- xdev nmos_rf_na18
AND ngate_rf1 NT_Ni ngate_rf_18na1;
AND ngate_rf_18na1 OD18 ngate_rf_18na2;
NOT ngate_rf_18na2 VTH_N ngate_rf_18na3;
NOT ngate_rf_18na3 VTL_N ngate_rf_18na4;
NOT ngate_rf_18na4 ILVT ngate_rf_18na; //  IO 1.8v Native RF NMOS
SELECT -INTERACT nthin ngate_rf_18na ngate_nthin_18na1 ;
NOT ngate_nthin_18na1 DNW ngate_nthin_18na2;
NOT ngate_nthin_18na2 RFDMY6T ngate_nthin_18na; //  nmos_rf_na18

//* Define device -- xdev nmos_rf_33
AND ngate_rfio3 OD33 ngate_rf_33; //  RF 3.3v nmos
SELECT -INTERACT nthin ngate_rf_33 ngate_nthin_331 ;
SELECT -INSIDE ngate_nthin_331 DNW ngate_nthin_332 ;
NOT ngate_nthin_332 RFDMY6T ngate_nthin_33; //  nmos_rf_33

//* Define device -- xdev nmos_rf_33_nodnw
SELECT -OUTSIDE ngate_nthin_331 DNW ngate_nthin_33nodnw ; //  nmos_rf_33_nodnw

//* Define device -- xdev nmos_rf_6t
AND ngate_nthin3 RFDMY6T ngate_nthin_6t; //  nmos_rf_6t

//* Define device -- xdev nmos_rf_hvt_6t
AND ngate_nthin_hv2 RFDMY6T ngate_nthin_hv_6t; //  nmos_rf_hvt_6t

//* Define device -- xdev nmos_rf_lvt_6t
AND ngate_nthin_lv2 RFDMY6T ngate_nthin_lv_6t; //  nmos_rf_lvt_6t

//* Define device -- xdev nmos_rf_25_6t
AND ngate_nthin_252 RFDMY6T ngate_nthin_25_6t; //  nmos_rf_25_6t

//* Define device -- xdev nmos_rf_25od33_6t
AND ngate_nthin_254 RFDMY6T ngate_nthin_25od_6t; //  nmos_rf_25od33_6t over_drive 3.3v 6T

//* Define device -- xdev nmos_rf_25ud18_6t
AND ngate_nthin_256 RFDMY6T ngate_nthin_25ud_6t; //  nmos_rf_25ud18_6t under_drive 1.8v 6T

//* Define device -- xdev nmos_rf_18_6t
AND ngate_nthin_182 RFDMY6T ngate_nthin_18_6t; //  nmos_rf_18_6t

//* Define device -- xdev nmos_rf_33_6t
AND ngate_nthin_332 RFDMY6T ngate_nthin_33_6t; //  nmos_rf_33_6t

//* Define device -- xdev pmos_rf
NOT pgate_rf3 VTH_P pgate_rfa;
NOT pgate_rfa VTL_P pgate_rfb;
NOT pgate_rfb ILVT pgate_rf; //  CORE RF pmos gate
SELECT -INTERACT pthin pgate_rf pgate_pthin1 ;
SELECT -INSIDE pgate_pthin1 DNW pgate_pthin2 ;
NOT pgate_pthin2 RDKDMY pgate_pthin3;
NOT pgate_pthin3 RFDMY5T pgate_pthin; //  pmos_rf

//* Define device -- xdev pmos_rf_rdk
AND pgate_pthin2 RDKDMY pgate_pthin_rdk1;
NOT pgate_pthin_rdk1 RFDMY5T pgate_pthin_rdk; //  pmos_rf_rdk

//* Define device -- xdev pmos_rf_nw
SELECT -OUTSIDE pgate_pthin1 DNW pgate_pthin_nw1 ;
NOT pgate_pthin_nw1 RFDMY5T pgate_pthin_nw; //  pmos_rf_nw

//* Define device -- xdev pmos_rf_hvt
AND pgate_rf3 VTH_P pgate_rfhv; //  CORE RF HVT pmos gatg
SELECT -INTERACT pthin pgate_rfhv pgate_pthin_hv1 ;
SELECT -INSIDE pgate_pthin_hv1 DNW pgate_pthin_hv2 ;
NOT pgate_pthin_hv2 RFDMY5T pgate_pthin_hv; //  pmos_rf_hvt

//* Define device -- xdev pmos_rf_hvt_nw
SELECT -OUTSIDE pgate_pthin_hv1 DNW pgate_pthin_hvnw1 ;
NOT pgate_pthin_hvnw1 RFDMY5T pgate_pthin_hvnw; //  pmos_rf_hvt_nw

//* Define device -- xdev pmos_rf_lvt
AND pgate_rf3 VTL_P pgate_rflv; //  CORE RF LVT pmos gate
SELECT -INTERACT pthin pgate_rflv pgate_pthin_lv1 ;
SELECT -INSIDE pgate_pthin_lv1 DNW pgate_pthin_lv2 ;
NOT pgate_pthin_lv2 RFDMY5T pgate_pthin_lv; //  pmos_rf_lvt

//* Define device -- xdev pmos_rf_lvt_nw
SELECT -OUTSIDE pgate_pthin_lv1 DNW pgate_pthin_lvnw1 ;
NOT pgate_pthin_lvnw1 RFDMY5T pgate_pthin_lvnw; //  pmos_rf_lvt_nw

//* Define device -- xdev pmos_rf_25
AND pgate_rf2 OD2 pgate_rfio1;
NOT pgate_rfio1 VTH_P pgate_rfio2;
NOT pgate_rfio2 VTL_P pgate_rfio3;
AND pgate_rfio3 OD25 pgate_rf_25a;
NOT pgate_rf_25a OD25_33 pgate_rf_25b;
NOT pgate_rf_25b OD25_18 pgate_rf_25c;
NOT pgate_rf_25c OD25_28 pgate_rf_25d;
SELECT -INTERACT pgate_rf_25d HVD_P -NOT pgate_rf_25;
SELECT -INTERACT pthin pgate_rf_25 pgate_pthin_251 ;
SELECT -INSIDE pgate_pthin_251 DNW pgate_pthin_252 ;
NOT pgate_pthin_252 RFDMY5T pgate_pthin_25; //  pmos_rf_25

//* Define device -- xdev pmos_rf_25_nw
SELECT -OUTSIDE pgate_pthin_251 DNW pgate_pthin_25nw1 ;
NOT pgate_pthin_25nw1 RFDMY5T pgate_pthin_25nw; //  pmos_rf_25_nw

//* Define device -- xdev pmos_rf_25od
AND pgate_rf_25a OD25_33 pgate_rf_25od; //  RF 2.5v pmos gate over_drive 3.3v
SELECT -INTERACT pthin pgate_rf_25od pgate_pthin_253 ;
SELECT -INSIDE pgate_pthin_253 DNW pgate_pthin_254 ;
NOT pgate_pthin_254 RFDMY5T pgate_pthin_25od; //  pmos_rf_25 over_drive 3.3v

//* Define device -- xdev pmos_rf_25_nwod
SELECT -OUTSIDE pgate_pthin_253 DNW pgate_pthin_25nwod1 ;
NOT pgate_pthin_25nwod1 RFDMY5T pgate_pthin_25nwod; //  pmos_rf_25od33_nw over_drive 3.3v

//* Define device -- xdev pmos_rf_25ud
AND pgate_rf_25a OD25_18 pgate_rf_25ud; //  RF 2.5v pmos gate over_drive 1.8v
SELECT -INTERACT pthin pgate_rf_25ud pgate_pthin_255 ;
SELECT -INSIDE pgate_pthin_255 DNW pgate_pthin_256 ;
NOT pgate_pthin_256 RFDMY5T pgate_pthin_25ud; //  pmos_rf_25ud18 under_drive 1.8v

//* Define device -- xdev pmos_rf_25_nwud
SELECT -OUTSIDE pgate_pthin_255 DNW pgate_pthin_25nwud1 ;
NOT pgate_pthin_25nwud1 RFDMY5T pgate_pthin_25nwud; //  pmos_rf_25ud18_nw under_drive 1.8v

//* Define device -- xdev pmos_rf_18
AND pgate_rfio3 OD18 pgate_rf_18; //  RF 1.8V pmos gate
SELECT -INTERACT pthin pgate_rf_18 pgate_pthin_181 ;
SELECT -INSIDE pgate_pthin_181 DNW pgate_pthin_182 ;
NOT pgate_pthin_182 RFDMY5T pgate_pthin_18; //  pmos_rf_18

//* Define device -- xdev pmos_rf_18_nw
SELECT -OUTSIDE pgate_pthin_181 DNW pgate_pthin_18nw1 ;
NOT pgate_pthin_18nw1 RFDMY5T pgate_pthin_18nw; //  pmos_rf_18_nw

//* Define device -- xdev pmos_rf_33
AND pgate_rfio3 OD33 pgate_rf_33; //  RF 3.3v pmos gate
SELECT -INTERACT pthin pgate_rf_33 pgate_pthin_331 ;
SELECT -INSIDE pgate_pthin_331 DNW pgate_pthin_332 ;
NOT pgate_pthin_332 RFDMY5T pgate_pthin_33; //  pmos_rf_33

//* Define device -- xdev pmos_rf_33_nw
SELECT -OUTSIDE pgate_pthin_331 DNW pgate_pthin_33nw1 ;
NOT pgate_pthin_33nw1 RFDMY5T pgate_pthin_33nw; //  pmos_rf_33_nw

//* Define device -- xdev pmos_rf_5t
AND pgate_pthin2 RFDMY5T pgate_pthin_5t; //  pmos_rf_5t

//* Define device -- xdev pmos_rf_nw_5t
AND pgate_pthin_nw1 RFDMY5T pgate_pthin_nw_5t; //  pmos_rf_nw_5t

//* Define device -- xdev pmos_rf_hvt_5t
AND pgate_pthin_hv2 RFDMY5T pgate_pthin_hv_5t; //  pmos_rf_hvt_5t

//* Define device -- xdev pmos_rf_hvt_nw_5t
AND pgate_pthin_hvnw1 RFDMY5T pgate_pthin_hvnw_5t; //  pmos_rf_hvt_nw_5t

//* Define device -- xdev pmos_rf_lvt_5t
AND pgate_pthin_lv2 RFDMY5T pgate_pthin_lv_5t; //  pmos_rf_lvt_5t

//* Define device -- xdev pmos_rf_lvt_nw_5t
AND pgate_pthin_lvnw1 RFDMY5T pgate_pthin_lvnw_5t; //  pmos_rf_lvt_nw_5t

//* Define device -- xdev pmos_rf_25_5t
AND pgate_pthin_252 RFDMY5T pgate_pthin_25_5t; //  pmos_rf_25_5t

//* Define device -- xdev pmos_rf_25_nw_5t
AND pgate_pthin_25nw1 RFDMY5T pgate_pthin_25nw_5t; //  pmos_rf_25_nw_5t

//* Define device -- xdev pmos_rf_25od33_5t
AND pgate_pthin_254 RFDMY5T pgate_pthin_25od_5t; //  pmos_rf_25_5t over_drive 3.3v 5T

//* Define device -- xdev pmos_rf_25od33_nw_5t
AND pgate_pthin_25nwod1 RFDMY5T pgate_pthin_25nwod_5t; //  pmos_rf_25od33_nw_5t over_drive 3.3v

//* Define device -- xdev pmos_rf_25ud18_5t
AND pgate_pthin_256 RFDMY5T pgate_pthin_25ud_5t; //  pmos_rf_25ud18_5t under_drive 1.8v 5T

//* Define device -- xdev pmos_rf_25ud18_nw_5t
AND pgate_pthin_25nwud1 RFDMY5T pgate_pthin_25nwud_5t; //  pmos_rf_25ud18_nw_5t under_drive 1.8v 5T

//* Define device -- xdev pmos_rf_18_5t
AND pgate_pthin_182 RFDMY5T pgate_pthin_18_5t; //  pmos_rf_18_5t

//* Define device -- xdev pmos_rf_18_nw_5t
AND pgate_pthin_18nw1 RFDMY5T pgate_pthin_18nw_5t; //  pmos_rf_18_nw_5t

//* Define device -- xdev pmos_rf_33_5t
AND pgate_pthin_332 RFDMY5T pgate_pthin_33_5t; //  pmos_rf_33_5t

//* Define device -- xdev pmos_rf_33_nw_5t
AND pgate_pthin_33nw1 RFDMY5T pgate_pthin_33nw_5t; //  pmos_rf_33_nw_5t

//* Define device -- xdev xjvar
AND VAR RFDMY VAR_RFi;
NOT VAR_RFi SBDDMY VAR_RF11;
NOT VAR_RF11 SBD3TDMY VAR_RF1;
NOT VAR_RF1 RBCDMY VAR_RF2;
SELECT -INTERACT VAR_RF2 gate_a VAR_RF ;
NOT VAR_RF2 VAR_RF XJ_RF;
AND nxwell XJ_RF jvar1_rf;
SELECT -INTERACT jvar1_rf tpdiff jvar2_rf ;
SELECT -INTERACT jvar2_rf tndiff jvar_rf1 ;
AND jvar_rf1 DNW jvar_rf;

//* Define device -- xdev xjvar_nw
AND jvar_rf1 tpdiff jvar3_rf;
AND tpdiff jvar_rf1 tpdiff_jvar;
AND tndiff jvar_rf1 tndiff_jvar;
NOT jvar_rf1 DNW jvar_rfnw;

//* Define device -- xdev moscap_rf
AND nxwell VAR_RF var_nw_rf;
NOT var_nw_rf OD18 var_nw1_rf;
NOT var_nw1_rf OD25 var_nw2_rf;
NOT var_nw2_rf OD33 var_nw3_rf1;
SELECT -INTERACT var_nw3_rf1 VTH_P -NOT var_nw3_rf2;
NOT var_nw3_rf2 RDKDMY var_nw3_rf3;
AND var_nw3_rf3 DNW var_nw3_rf; //  moscap_rf

//* Define device -- xdev pmoscap_rf
AND gate_a_rf VAR_RF vargt2_rf;
OR OD25 OD25_18 OD2a;
OR OD2a OD25_33 OD2b;
OR OD2b OD18 OD2c;
OR OD2c OD33 OD2d;
OR OD2d OD5 OD2e;
OR OD2e OD6 OD2f;
OR OD2f OD25_28 OD2_mos;
NOT vargt2_rf OD2_mos vargt_rf1;
NOT vargt_rf1 VTH_P vargt_rf; //  RF Varactor on thin oxide

//* Define device -- xdev moscap_rf_rdk
AND var_nw3_rf2 RDKDMY var_nw3_rdk1;
AND var_nw3_rdk1 DNW var_nw3_rdk; //  moscap_rf_rdk

//* Define device -- xdev moscap_rf_nw
NOT var_nw3_rf3 DNW var_nw3_rf_nw; //  moscap_rf_nw

//* Define device -- xdev moscap_rf_hvt
SELECT -INTERACT var_nw3_rf1 VTH_P var_nw3_rf4 ;
AND var_nw3_rf4 DNW var_nw3_rf_hvt;

//* Define device -- xdev moscap_rf_hvt_nw
AND vargt_rf1 VTH_P vargt_rf_hvt; //  RF Varactor on thin oxide with VTH_P
NOT var_nw3_rf4 DNW var_nw3_rf_hvt_nw;

//* Define device -- xdev moscap_rf25
AND var_nw_rf OD25 var_nw_rf25a;
AND var_nw_rf25a DNW var_nw_rf25;

//* Define device -- xdev pmoscap_rf25
AND vargt2_rf OD25 vargt_rf25; //  RF Varactor on 2.5v thick oxide

//* Define device -- xdev moscap_rf25_nw
NOT var_nw_rf25a DNW var_nw_rf25_nw;

//* Define device -- xdev moscap_rf18
AND var_nw_rf OD18 var_nw_rf18a;
AND var_nw_rf18a DNW var_nw_rf18;

//* Define device -- xdev pmoscap_rf18
AND vargt2_rf OD18 vargt_rf18; //  RF Varactor on 1.8v thick oxide

//* Define device -- xdev moscap_rf18_nw
NOT var_nw_rf18a DNW var_nw_rf18_nw;

//* Define device -- xdev moscap_rf33
AND var_nw_rf OD33 var_nw_rf33a;
AND var_nw_rf33a DNW var_nw_rf33;

//* Define device -- xdev moscap_rf33_nw
AND vargt2_rf OD33 vargt_rf33; //  RF Varactor on 3.3v thick oxide
NOT var_nw_rf33a DNW var_nw_rf33_nw;

//* Define device -- xdev sbd_rf
AND SBDDMY RFDMY SBD_RF1;
NOT SBD_RF1 VAR SBD_RF;
AND nxwell SBD_RF sbd_nw;
AND nthin1 sbd_nw schottky_n;
SELECT -INTERACT sbd_nw schottky_n sbd_rfnw_org1 ;
SELECT -CUT mdiff PP pthin1 ;
AND pthin1 sbd_nw schottky_p;
SELECT -INTERACT sbd_rfnw_org1 schottky_p sbd_rfnw_org ;
SELECT -INTERACT sbd_rfnw_org DNW sbd_rfdnw ;

//* Define device -- xdev sbd_rf_nw
SELECT -INTERACT sbd_rfnw_org DNW -NOT sbd_rfnw;

//* Define device -- xdev rppolyl_rf
NOT rppolyl_d1 rppolyl_d rppolyl_rf1;
AND rppolyl_rf1 RFDMY rppolyl_rf2;
NOT rppolyl_rf2 RDKDMY rppolyl_rf; //  RF P+POLY resistor w/i silicide >=  2 (3-Terminals)

//* Define device -- xdev rppolys_rf
NOT rppolys_d1 rppolyl_d rppolys_rf1;
AND rppolys_rf1 RFDMY rppolys_rf2;
NOT rppolys_rf2 RDKDMY rppolys_rf; //  RF P+POLY resistor w/i silicide < 2 (3-Terminals)

//* Define device -- xdev rppolywo_rf
AND rppolywo_r1 RFDMY rppolywo_rf1;
NOT rppolywo_rf1 RDKDMY rppolywo_rf; //   RF P+POLY resistor w/o silicide (3-terminals)       

//* Define device -- xdev rppolyl_rf_rdk
AND rppolyl_rf2 RDKDMY rppolyl_rf_rdk; //  RF RDK P+POLY resistor w/i silicide >=  2 (3-Terminals)

//* Define device -- xdev rppolys_rf_rdk
AND rppolys_rf2 RDKDMY rppolys_rf_rdk; //  RF RDK P+POLY resistor w/i silicide < 2 (3-Terminals)

//* Define device -- xdev rppolywo_rf_rdk
AND rppolywo_rf1 RDKDMY rppolywo_rf_rdk; //   RF RDK P+POLY resistor w/o silicide (3-terminals)   

//* Define device -- xdev ndio_hia_rf
AND ndio1a HIADMY ndio_hia1;
AND ndio_hia1 psub ndio_hia2;
NOT ndio_hia2 OD18 ndio_hia3;
NOT ndio_hia3 OD25 ndio_hia4;
NOT ndio_hia4 OD33 ndio_hia5;
NOT ndio_hia5 DCO ndio_hia6;
NOT ndio_hia6 NT_Ni ndio_hia7;
NOT ndio_hia7 VTH_N ndio_hia8;
NOT ndio_hia8 VTL_N ndio_hia9;
NOT ndio_hia9 ILVT ndio_hia10;
NOT ndio_hia10 UHVT_N ndio_hia11;
AND ndio_hia11 RFDMY ndio_hia12;
NOT ndio_hia12 RBCDMY ndio_hia;

//* Define device -- xdev pdio_hia_rf
AND pdio1a HIADMY pdio_hia1;
AND pdio_hia1 nxwell pdio_hia2;
NOT pdio_hia2 OD18 pdio_hia3;
NOT pdio_hia3 OD25 pdio_hia4;
NOT pdio_hia4 OD33 pdio_hia5;
NOT pdio_hia5 DCO pdio_hia6;
NOT pdio_hia6 VTH_P pdio_hia7;
NOT pdio_hia7 VTL_P pdio_hia8;
NOT pdio_hia8 ILVT pdio_hia9;
NOT pdio_hia9 UHVT_P pdio_hia10;
AND pdio_hia10 RFDMY pdio_hia11;
NOT pdio_hia11 RBCDMY pdio_hia;

//***** Define connectivity/via layer -- RFDMY_hia ****
AND HIADMY nxwell dio_inrf1;
SELECT -INSIDE dio_inrf1 RFDMY dio_inrf ;
SELECT -INTERACT RFDMY dio_inrf RFDMY_hia1 ;
NOT RFDMY_hia1 RBCDMY RFDMY_hia;
NOT VAR_RF nxwell pvar_rf1;
AND pvar_rf1 DNW pvar_rf2;
NOT pvar_rf2 OD33 pvar_rf3;
NOT pvar_rf3 OD18 pvar_rf4;
NOT pvar_rf4 OD25 pvar_rf;
AND pvar_rf3 OD18 pvar_rf18a;
NOT pvar_rf18a OD25 pvar_rf18;
AND pvar_rf4 OD25 pvar_rf25;

//* Define device -- xdev sline_ms_mu
SELECT -LABEL INDDMY -TEXTNAME "sline_ms_mu" -TEXTLAYER IND_TEXT sline_ms_mu_r;

//***** Define connectivity/via layer -- sline_m9p ****
AND M9 TLDMY sline_m9;
AND sline_m9 INDDMY sline_m9a;
NOT sline_m9a IND_MP sline_m9p;

//***** Define connectivity/via layer -- sline_m9m ****
AND sline_m9a IND_MP sline_m9m1;
SIZE sline_m9p -BY 0.001 sline_m9p2
NOT sline_m9m1 sline_m9p2 sline_m9m;

//* Define device -- xdev sline_gscpw_mu
SELECT -LABEL INDDMY -TEXTNAME "sline_gscpw_mu" -TEXTLAYER IND_TEXT sline_cpw_mu_r;

//***** Define connectivity/via layer -- sline_m8 ****
AND M8 TLDMY sline_m8a;
AND sline_m8a INDDMY sline_m8;

//* Define device -- xdev spiral_std_mu_z
AND M9 IND_STD std_ind1;
AND M8 IND_STD std_ind21;
NOT IND_RADi RBCDMY IND_RAD; //  IND_RAD should not interact RBCDMY for regular spiral devices
SELECT -INTERACT std_ind21 IND_RAD std_ind2 ;
OR std_ind1 std_ind2 std_ind3;
SELECT -INTERACT std_ind3 IND_RAD std_ind4 ;
NOT std_ind4 RDKDMY std_ind; //  mu_z (1z1u top2 thick) std spiral

//* Define device -- xdev spiral_std_mu_z_rdk
AND std_ind1 std_ind2 std_ind_m;

//***** Define connectivity/via layer -- indm9p ****
SIZE INDDMY -BY 0.005 indm9b
SELECT -INTERACT indm9b TLDMY -NOT indm9a;
AND indm9a M9Y indm9;
NOT indm9 IND_MP indm9p1;
SELECT -INTERACT indm9p1 IND_MP -NOT indm9p2;
NOT indm9p2 IND_D4 indm9p;

//***** Define connectivity/via layer -- indm9m ****
AND indm9 IND_MP indm9m;

//* Define device -- xdev spiral_sym_mu_z
AND M9 IND_SYM sym_ind1;
AND M8 IND_SYM sym_ind2;
OR sym_ind1 sym_ind2 sym_ind3;
SELECT -INTERACT sym_ind3 IND_RAD sym_ind4 ;
NOT sym_ind4 RDKDMY sym_ind; //  mu_z(1z1u top2 thick) sym spiral

//* Define device -- xdev spiral_sym_mu_z_rdk
AND sym_ind1 sym_ind2 sym_ind_m;

//* Define device -- xdev spiral_sym_ct_mu_z
AND M9 IND_CT ct_ind1;
AND M8 IND_CT ct_ind2;
OR ct_ind1 ct_ind2 ct_inda1;
SELECT -INTERACT ct_inda1 IND_NR ct_inda ;
AND M7 IND_CT ct_ind3;
OR ct_inda ct_ind3 ct_ind4;
SELECT -INTERACT ct_ind4 IND_RAD ct_ind5 ;
NOT ct_ind5 RDKDMY ct_ind; //  mu_z(1z1u top2_thick) ctap spiral

//* Define device -- xdev spiral_sym_ct_mu_z_rdk
AND ct_ind1 ct_ind2 ct_ind_m;

//***** Define connectivity/via layer -- indm9c ****
AND indm9p2 IND_D4 indm9p3;
SELECT -INTERACT indm9p3 indm9p indm9p4 ;
NOT IND_D4 indm9p4 IND_D41;
NOT IND_D41 indm9m IND_D42;
SIZE IND_D42 -BY -0.001 IND_D4i
AND indm9 IND_D4i indm9c1;
AND indm9a M8Y indm8;
AND indm8 IND_D4i indm9c2;
OR indm9c1 indm9c2 indm9c4;
AND indm9a M7Y indm7;
AND indm7 IND_D4i indm9c3;
OR indm9c4 indm9c3 indm9c;
AND std_ind4 RDKDMY std_ind_rdk; //  mu_z (1z1u top2 thick) std spiral(RDK)
AND sym_ind4 RDKDMY sym_ind_rdk; //  mu_z(1z1u top2 thick) sym spiral(RDK)
AND ct_ind5 RDKDMY ct_ind_rdk; //  mu_z(1z1u top2_thick) ctap spiral(RDK)

//* Define device -- xdev mimcap_sin_3t
AND ctm cbm mim_top;

//***** Define connectivity/via layer -- PROBEM1_T ****
SIZE PROBEM1 -BY 0.005 PROBEM1_T1
NOT PROBEM1_T1 PROBEM1 PROBEM1_T;

//***** Define connectivity/via layer -- PROBEM2_T ****
SIZE PROBEM2 -BY 0.005 PROBEM2_T1
NOT PROBEM2_T1 PROBEM2 PROBEM2_T;

//***** Define connectivity/via layer -- PROBEM3_T ****
SIZE PROBEM3 -BY 0.005 PROBEM3_T1
NOT PROBEM3_T1 PROBEM3 PROBEM3_T;

//***** Define connectivity/via layer -- PROBEM4_T ****
SIZE PROBEM4 -BY 0.005 PROBEM4_T1
NOT PROBEM4_T1 PROBEM4 PROBEM4_T;

//***** Define connectivity/via layer -- PROBEM5_T ****
SIZE PROBEM5 -BY 0.005 PROBEM5_T1
NOT PROBEM5_T1 PROBEM5 PROBEM5_T;

//***** Define connectivity/via layer -- PROBEM6_T ****
SIZE PROBEM6 -BY 0.005 PROBEM6_T1
NOT PROBEM6_T1 PROBEM6 PROBEM6_T;

//***** Define connectivity/via layer -- PROBEM7_T ****
SIZE PROBEM7 -BY 0.005 PROBEM7_T1
NOT PROBEM7_T1 PROBEM7 PROBEM7_T;

//* Define device -- xdev lincap
AND nxwell VTDN lin_nw1;
NOT lin_nw1 RFDMY lin_nw2;
NOT lin_nw2 OD25 lin_nw3;
AND lin_nw3 DNW lin_nw; //  Linear Cap
AND vargt1 VTDN lingt1;
NOT lingt1 OD25 lingt;

//* Define device -- xdev lincap_25
AND lin_nw2 OD25 lin_nw4;
AND lin_nw4 DNW lin_nw_25; //  2.5 Linear Cap
AND lingt1 OD25 lingt_25;

//* Define device -- xdev lincap_rf
AND lin_nw1 RFDMY lin_nw5;
NOT lin_nw5 OD25 lin_nw6;
AND lin_nw6 DNW lin_nw_rf; //  RF Linear Cap
AND gate_a_rf NW lingt2;
AND lingt2 NP lingt3;
AND lingt3 VTDN lingt4;
NOT lingt4 OD25 lingt_rf;

//* Define device -- xdev lincap_rf_25
AND lin_nw5 OD25 lin_nw7;
AND lin_nw7 DNW lin_nw_rf_25; //  RF 2.5 Linear Cap
AND lingt4 OD25 lingt_rf_25;

//* Define device -- xdev lowcpad_d23
AND AP RFPADDMY ap_pad;
AND M9 RFPADDMY m9_pad;
AND ap_pad m9_pad rfpad1;
AND M8 RFPADDMY m8_pad;
SELECT -INTERACT rfpad1 m8_pad rfpad2 ;
AND rfpad2 PP rfpad3;
AND rfpad3 PO rfpad4;
SELECT -INTERACT rfpad4 CB rfpad5 ;
SELECT -INTERACT rfpad5 CB2 rfpad6 ;
SELECT -INTERACT rfpad6 VIA8i rfpad7 ;
NOT rfpad7 RBCDMY rfpad;
AND M1 RFPADDMY m1_pad;
AND M2 RFPADDMY m2_pad;
OR m1_pad m2_pad bot_dmy1;
AND M3 RFPADDMY m3_pad;
OR bot_dmy1 m3_pad bot_dmy2;
AND M4 RFPADDMY m4_pad;
OR bot_dmy2 m4_pad bot_dmy3;
AND M5 RFPADDMY m5_pad;
OR bot_dmy3 m5_pad bot_dmy4;
AND M6 RFPADDMY m6_pad;
OR bot_dmy4 m6_pad bot_dmy5;
AND M7 RFPADDMY m7_pad;
OR bot_dmy5 m7_pad bot_dmy6;
COPY bot_dmy6 bot_dmy;

//* Define device -- xdev nmos_rf_diff_nw
AND rf_diff DIFRBC nthin_diff1;
NOT gate_rbc nxwell ngate_rfc1;
AND ngate_rfc1 NP ngate_rfc2;
NOT ngate_rfc2 NT_Ni ngate_rfc;
AND ngate_rfc DIFRBC gate_rbc_diff;
SELECT -INTERACT nthin_diff1 gate_rbc_diff nthin_diff_ori ;
SELECT -INTERACT nthin_diff_ori DNW -NOT nthin_diff_nw;

//* Define device -- xdev nmos_rf_cross_nw
AND rf_diff XCLRBC nthin_xcouple1;
AND ngate_rfc XCLRBC gate_rbc_xcoup;
SELECT -INTERACT nthin_xcouple1 gate_rbc_xcoup nthin_xcouple_ori ;
SELECT -INTERACT nthin_xcouple_ori DNW -NOT nthin_xcouple_nw;

//* Define device -- xdev nmos_rf_cas_nw
AND rf_diff CASRBC nthin_cas1;
AND ngate_rfc CASRBC gate_rbc_cas;
SELECT -INTERACT nthin_cas1 gate_rbc_cas nthin_cas_ori ;
SELECT -INTERACT nthin_cas_ori DNW -NOT nthin_cas_nw;

//***** Define connectivity/via layer -- gate_rbc_casb ****
SELECT -INTERACT gate_rbc_cas GTDMY2 gate_rbc_casb ;

//***** Define connectivity/via layer -- gate_rbc_cast ****
SELECT -INTERACT gate_rbc_cas GTDMY1 gate_rbc_cast ;

//* Define device -- xdev rfesd_rf1
AND RFESDMY RBCDMY rfesd_dmy1;
AND rfpad7 RBCDMY rfpad_a;
SELECT -INTERACT rfesd_dmy1 rfpad_a rfesd_dmy ;
SELECT -LABEL RBCDMY -TEXTNAME "rfesd_rf1" -TEXTLAYER RBC_TEXT rfesd_r1a;
SELECT -INTERACT rfesd_dmy rfesd_r1a rfesd_r1 ;

//***** Define connectivity/via layer -- cpad ****
AND HIADMY RBCDMY hiadmy_rbc;
SELECT -INTERACT metal9 hiadmy_rbc cpad1 ;
SELECT -INTERACT cpad1 indm9m cpad2 ;
SELECT -INTERACT cpad2 indm9p -NOT cpad;

//* Define device -- xdev rfesd_rf2
SELECT -LABEL RBCDMY -TEXTNAME "rfesd_rf2" -TEXTLAYER RBC_TEXT rfesd_r2a;
SELECT -INTERACT rfesd_dmy rfesd_r2a rfesd_r2 ;

//* Define device -- xdev rfesd_rf3
SELECT -LABEL RBCDMY -TEXTNAME "rfesd_rf3" -TEXTLAYER RBC_TEXT rfesd_r3a;
SELECT -INTERACT rfesd_dmy rfesd_r3a rfesd_r3 ;

//* Define device -- xdev rfesd_rf4
SELECT -LABEL RBCDMY -TEXTNAME "rfesd_rf4" -TEXTLAYER RBC_TEXT rfesd_r4a;
SELECT -INTERACT rfesd_dmy rfesd_r4a rfesd_r4 ;

//* Define device -- xdev rfesd_rf5
SELECT -LABEL RBCDMY -TEXTNAME "rfesd_rf5" -TEXTLAYER RBC_TEXT rfesd_r5a;
SELECT -INTERACT rfesd_dmy rfesd_r5a rfesd_r5 ;

//* Define device -- xdev rfesd_rf6
SELECT -LABEL RBCDMY -TEXTNAME "rfesd_rf6" -TEXTLAYER RBC_TEXT rfesd_r6a;
SELECT -INTERACT rfesd_dmy rfesd_r6a rfesd_r6 ;

//* Define device -- xdev rfesd_rf7
SELECT -LABEL RBCDMY -TEXTNAME "rfesd_rf7" -TEXTLAYER RBC_TEXT rfesd_r7a;
SELECT -INTERACT rfesd_dmy rfesd_r7a rfesd_r7 ;

//* Define device -- xdev rfesd_rf8
SELECT -LABEL RBCDMY -TEXTNAME "rfesd_rf8" -TEXTLAYER RBC_TEXT rfesd_r8a;
SELECT -INTERACT rfesd_dmy rfesd_r8a rfesd_r8 ;

//***** Define connectivity/via layer -- polyCont ****
SELECT -INTERACT CO POI polyCont ;

//***** Define connectivity/via layer -- PROBEM6_B ****
AND PROBEM6_T BULK PROBEM6_B;

//***** Define connectivity/via layer -- mom3p1 ****
AND metal3 MOMDMY23 mom3p11;
SELECT -INTERACT mom3p11 MOMDMY25 mom3p1 ;

//***** Define connectivity/via layer -- PROBEM5_B ****
AND PROBEM5_T BULK PROBEM5_B;

//***** Define connectivity/via layer -- PROBEM2_B ****
AND PROBEM2_T BULK PROBEM2_B;

//***** Define connectivity/via layer -- PROBEM1_B ****
AND PROBEM1_T BULK PROBEM1_B;

//***** Define connectivity/via layer -- mom5m1 ****
AND metal5 MOMDMY23 mom5p11;
SELECT -INTERACT mom5p11 MOMDMY25 -NOT mom5m1;

//***** Define connectivity/via layer -- mom7p1 ****
AND metal7 MOMDMY23 mom7p11;
SELECT -INTERACT mom7p11 MOMDMY25 mom7p1 ;

//***** Define connectivity/via layer -- PROBEM4_B ****
AND PROBEM4_T BULK PROBEM4_B;

//***** Define connectivity/via layer -- mom6m1 ****
AND metal6 MOMDMY23 mom6p11;
SELECT -INTERACT mom6p11 MOMDMY25 -NOT mom6m1;

//***** Define connectivity/via layer -- RFDMY_hia_psub ****
NOT RFDMY_hia nxwell RFDMY_hia_psub;

//***** Define connectivity/via layer -- PROBEM7_B ****
AND PROBEM7_T BULK PROBEM7_B;

//***** Define connectivity/via layer -- ntaphv ****
AND tndiff HVNW hvntap1;
SELECT -INTERACT hvntap1 CO hvntap2 ;
SELECT -INTERACT CO OD odCont1 ;
SELECT -INTERACT CO p3 p3Cont ;
NOT odCont1 p3Cont odCont;
SELECT -INTERACT tpdiff odCont tpdiffco ;
SELECT -INTERACT hvntap1 tpdiffco hvntap3 ;
OR hvntap2 hvntap3 ntaphv;

//***** Define connectivity/via layer -- mom7m2 ****
AND metal7 MOMDMY24 mom7p21;
SELECT -INTERACT mom7p21 MOMDMY25 -NOT mom7m2;

//***** Define connectivity/via layer -- mom7m1 ****
SELECT -INTERACT mom7p11 MOMDMY25 -NOT mom7m1;

//***** Define connectivity/via layer -- n_psub ****
NOT BULK psubband n_psub;

//***** Define connectivity/via layer -- mom4m2 ****
AND metal4 MOMDMY24 mom4p21;
SELECT -INTERACT mom4p21 MOMDMY25 -NOT mom4m2;

//***** Define connectivity/via layer -- pplug ****
AND tpdiff psub pplug1;
SELECT -INTERACT pplug1 odCont pplug2 ;
SELECT -INTERACT tndiff odCont tndiffco ;
SELECT -INTERACT pplug1 tndiffco pplug3 ;
OR pplug2 pplug3 pplug; //  define p_sub contact

//***** Define connectivity/via layer -- MOM_field4 ****
AND M4 MOMDMY4 MOM_field4;

//***** Define connectivity/via layer -- rfdmy56_via ****
AND rfdmy56 psub rfdmy56_via1;
SELECT -INSIDE rwel rfdmy56 rwel_rfdmy56 ;
NOT rfdmy56_via1 rwel_rfdmy56 rfdmy56_via2;
SELECT -INTERACT NW rwel nw_dnw ;
NOT rfdmy56_via2 nw_dnw rfdmy56_via;

//***** Define connectivity/via layer -- mom4m1 ****
AND metal4 MOMDMY23 mom4p11;
SELECT -INTERACT mom4p11 MOMDMY25 -NOT mom4m1;

//***** Define connectivity/via layer -- MOM_field5 ****
AND M5 MOMDMY5 MOM_field5;

//***** Define connectivity/via layer -- mom5p1 ****
SELECT -INTERACT mom5p11 MOMDMY25 mom5p1 ;

//***** Define connectivity/via layer -- VIA9 ****
OR RV CBD VIA9a;
OR VIA9a CB VIA9;

//* Define ERC or other layers
NOT tngate1 VAR erc_nmos_gates1;
OR erc_nmos_gates1 hngate erc_nmos_gates2;
AND hngate7 DNW dhngate1;
AND dhngate1 HVPW dhngate;
OR erc_nmos_gates2 dhngate erc_nmos_gates3;
OR erc_nmos_gates3 hzgate erc_nmos_gates;

//***** Define connectivity/via layer -- ydio_ass ****
COPY ydio ydio_ass;

//***** Define connectivity/via layer -- gate1_not_IO2 ****
NOT gate1 OD25 gate1_not_IO1;
NOT gate1_not_IO1 OD33 gate1_not_IO2;

//***** Define connectivity/via layer -- rf_hia_via ****
SIZE RFDMY_hia_psub -BY 0.005 rf_hia_via1
NOT rf_hia_via1 RFDMY_hia_psub rf_hia_via2;
AND rf_hia_via2 psub rf_hia_via;
OR NW NT_Ni nw_ntn;
NOT OD2 nw_ntn nIO; //  nmos IO for WPE (clear tone)
NOT SRM SRAMTIMER stimer;
NOT gate1 stimer gate_a1;

//***** Define connectivity/via layer -- indm10c ****
AND indm9a M10Y indm10;
SELECT -INTERACT indm10 IND_D4 indm10c ;

//***** Define connectivity/via layer -- MOM_field2 ****
AND M2 MOMDMY2 MOM_field2;

//***** Define connectivity/via layer -- VIA1 ****
COPY VIA1i VIA1; //  VIA1

//***** Define connectivity/via layer -- MOM_field7 ****
AND M7 MOMDMY7 MOM_field7;

//***** Define connectivity/via layer -- dnwc_hvnw ****
AND DNW HVNW dnwc_hvnw;

//***** Define connectivity/via layer -- nxwell_npn ****
SELECT -TOUCH ncolls cemit1 ncollsa ;
NOT ncolls ncollsa nxwell_npn;

//***** Define connectivity/via layer -- mom6p1 ****
SELECT -INTERACT mom6p11 MOMDMY25 mom6p1 ;

//***** Define connectivity/via layer -- nplug ****
AND tndiff nxwell nplug1;
SELECT -INTERACT nplug1 odCont nplug2 ;
SELECT -INTERACT nplug1 tpdiffco nplug3 ;
OR nplug2 nplug3 nplug; //  define N_well contact
NOT tpgate1 VAR erc_pmos_gates1;
OR erc_pmos_gates1 hpgate erc_pmos_gates;

//***** Define connectivity/via layer -- mom5p2 ****
AND metal5 MOMDMY24 mom5p21;
SELECT -INTERACT mom5p21 MOMDMY25 mom5p2 ;

//***** Define connectivity/via layer -- ntap ****
SELECT -OUTSIDE NW NWDMY xwell ;
AND tndiff xwell ntapx;
NOT ntapx BJTDMY ntap0;
NOT ntap0 BJT4TDMY ntap1;
SELECT -INTERACT ntap1 CO ntap2 ;
SELECT -INTERACT ntap1 tpdiffco ntap3 ;
OR ntap2 ntap3 ntap;

//***** Define connectivity/via layer -- hvptap ****
AND tpdiff HVPSUB hvptap1;
SELECT -INTERACT hvptap1 CO hvptap2 ;
SELECT -INTERACT hvptap1 tndiffco hvptap3 ;
OR hvptap2 hvptap3 hvptap;

//***** Define connectivity/via layer -- poly_nw_via ****
AND poly_term nxwell poly_nw_via;
NOT NW NT_Ni c_pmall1;
NOT c_pmall1 OD33 pCore; //  pmos all for WPE (clear tone)

//***** Define connectivity/via layer -- MOM_field3 ****
AND M3 MOMDMY3 MOM_field3;

//***** Define connectivity/via layer -- hiaplug ****
AND tpdiff RFDMY_hia hiaplug1;
SELECT -INTERACT hiaplug1 CO hiaplug2 ;
SELECT -INTERACT hiaplug1 tndiffco hiaplug3 ;
OR hiaplug2 hiaplug3 hiaplug4;
NOT hiaplug4 nxwell hiaplug;
SELECT -INTERACT nxwell VAR -NOT nxwell_float1; //  exclude nwell under VAR for floating nwell check
SELECT -INTERACT nxwell_float1 trwell -NOT nxwell_float2; //  exclude nwell resistor for floating nwell check
NOT nxwell_float2 TCDDMY nxwell_float; //  exclude dummy nwell under TCDDMY

//***** Define connectivity/via layer -- PROBEM3_B ****
AND PROBEM3_T BULK PROBEM3_B;

//***** Define connectivity/via layer -- VIA2 ****
COPY VIA2i VIA2; //  VIA2

//***** Define connectivity/via layer -- MOM_field6 ****
AND M6 MOMDMY6 MOM_field6;
AND c_pmall1 OD33 pIO; //  pmos IO 3.3V WPE

//***** Define connectivity/via layer -- mom5m2 ****
SELECT -INTERACT mom5p21 MOMDMY25 -NOT mom5m2;

//***** Define connectivity/via layer -- dnwc ****
AND DNW nxwell dnwc;
COPY HVNW nxwell_hv;

//***** Define connectivity/via layer -- tiod ****
NOT diff tpdiff tioda;
NOT tioda tndiff tiodb;
NOT tiodb PO tiod1;
NOT tiod1 RPO tiod2;
NOT tiod2 RPDMY tiod3;
NOT tiod3 NWDMY tiod; //  RPO, RPDMY, NWDMY cut ti-od

//***** Define connectivity/via layer -- mom4p2 ****
SELECT -INTERACT mom4p21 MOMDMY25 mom4p2 ;

//***** Define connectivity/via layer -- VIA5 ****
COPY VIA5i VIA5; //  VIA5
OR OD2 nw_ntn d_nmcore; //  nmos core for WPE (Dark tone)
NOT BULK d_nmcore nCore; //  nmos core for WPE (clear tone)

//***** Define connectivity/via layer -- mom6m2 ****
AND metal6 MOMDMY24 mom6p21;
SELECT -INTERACT mom6p21 MOMDMY25 -NOT mom6m2;

//***** Define connectivity/via layer -- mom7p2 ****
SELECT -INTERACT mom7p21 MOMDMY25 mom7p2 ;

//***** Define connectivity/via layer -- VIA3 ****
COPY VIA3i VIA3; //  VIA3

//***** Define connectivity/via layer -- mom3m2 ****
AND metal3 MOMDMY24 mom3p21;
SELECT -INTERACT mom3p21 MOMDMY25 -NOT mom3m2;

//***** Define connectivity/via layer -- VIA4 ****
COPY VIA4i VIA4; //  VIA4

//***** Define connectivity/via layer -- mom4p1 ****
SELECT -INTERACT mom4p11 MOMDMY25 mom4p1 ;

//***** Define connectivity/via layer -- mom3p2 ****
SELECT -INTERACT mom3p21 MOMDMY25 mom3p2 ;

//***** Define connectivity/via layer -- VIA6 ****
COPY VIA6i VIA6; //  VIA6

//***** Define connectivity/via layer -- mom6p2 ****
SELECT -INTERACT mom6p21 MOMDMY25 mom6p2 ;

//***** Define connectivity/via layer -- n_pplug ****
SELECT -INTERACT mdiff odCont n_pplug1 ;
AND n_pplug1 PP n_pplug2;
NOT n_pplug2 nxwell n_pplug3_1;
AND gatennw PP vargt1_p;
NOT n_pplug3_1 vargt1_p n_pplug3_2;
NOT n_pplug3_2 HVNW n_pplug3;
NOT n_pplug3 rwel n_pplug4;
AND n_pplug4 n_psub n_pplug;

//***** Define connectivity/via layer -- poly_psub_via ****
AND poly_term psub poly_psub_via;
COPY NT_Ni nt_n;

//***** Define connectivity/via layer -- mom3m1 ****
SELECT -INTERACT mom3p11 MOMDMY25 -NOT mom3m1;

//***** Define connectivity/via layer -- ptap ****
AND tpdiff psub ptap1;
SELECT -INTERACT ptap1 CO ptap2 ;
SELECT -INTERACT ptap1 tndiffco ptap3 ;
OR ptap2 ptap3 ptap;

//***** Define connectivity/via layer -- MOM_field1 ****
AND M1 MOMDMY1 MOM_field1;
//#############################################
//# CONNECTION                                #
//#############################################
CONNECT MOM_field1 metal1
CONNECT MOM_field2 MOM_field1 -BY VIA1;
CONNECT MOM_field2 metal2
CONNECT MOM_field3 MOM_field2 -BY VIA2;
CONNECT MOM_field3 metal3
CONNECT MOM_field4 MOM_field3 -BY VIA3;
CONNECT MOM_field4 metal4
CONNECT MOM_field5 MOM_field4 -BY VIA4;
CONNECT MOM_field5 metal5
CONNECT MOM_field6 MOM_field5 -BY VIA5;
CONNECT MOM_field6 metal6
CONNECT MOM_field7 MOM_field6 -BY VIA6;
CONNECT MOM_field7 metal7
CONNECT cemit1 tpdiff
CONNECT cnbase1 tndiff -BY nplug;
CONNECT cnemit1 tndiff
CONNECT cpad metal9
CONNECT cpbase1 tpdiff -BY pplug;
CONNECT d_nd25hvdw tndiff
CONNECT d_nd25hvdw tpdiff
CONNECT d_nd25hvi tpdiff
CONNECT d_pd25hvd tndiff
CONNECT d_pd25hvd tpdiff
CONNECT d_tndiff tndiff
CONNECT d_tpdiff tpdiff
CONNECT gate1 poly
CONNECT gate1_not_IO2 poly
CONNECT gate_rbc_casb poly
CONNECT gate_rbc_cast poly
CONNECT gate_rbc_diff poly
CONNECT gate_rbc_xcoup poly
CONNECT metal1 d_nd25hvdw -BY odCont;
CONNECT metal1 d_pd25hvd -BY odCont;
CONNECT metal1 d_tndiff -BY odCont;
CONNECT metal1 d_tpdiff -BY odCont;
CONNECT metal1 p3 -BY p3Cont;
CONNECT metal1 poly -BY polyCont;
CONNECT metal1 s_nd25hvdw -BY odCont;
CONNECT metal1 s_pd25hvd -BY odCont;
CONNECT metal1 s_tndiff -BY odCont;
CONNECT metal1 s_tndiff_cas -BY odCont;
CONNECT metal1 s_tpdiff -BY odCont;
CONNECT metal1 schottky_n -BY odCont;
CONNECT metal1 schottky_p -BY odCont;
CONNECT metal1 tndiff -BY odCont;
CONNECT metal1 tpdiff -BY odCont;
CONNECT metal10 indm10c
CONNECT metal10 metal9 -BY VIA9;
CONNECT metal2 metal1 -BY VIA1;
CONNECT metal3 metal2 -BY VIA2;
CONNECT metal3 mom3m1
CONNECT metal3 mom3m2
CONNECT metal3 mom3p1
CONNECT metal3 mom3p2
CONNECT metal4 metal3 -BY VIA3;
CONNECT metal4 mom4m1
CONNECT metal4 mom4m2
CONNECT metal4 mom4p1
CONNECT metal4 mom4p2
CONNECT metal5 metal4 -BY VIA4;
CONNECT metal5 mom5m1
CONNECT metal5 mom5m2
CONNECT metal5 mom5p1
CONNECT metal5 mom5p2
CONNECT metal6 metal5 -BY VIA5;
CONNECT metal6 mom6m1
CONNECT metal6 mom6m2
CONNECT metal6 mom6p1
CONNECT metal6 mom6p2
CONNECT metal7 indm9c
CONNECT metal7 metal6 -BY VIA6;
CONNECT metal7 mom7m1
CONNECT metal7 mom7m2
CONNECT metal7 mom7p1
CONNECT metal7 mom7p2
CONNECT metal8 indm9c
CONNECT metal8 sline_m8
CONNECT metal9 indm9c
CONNECT metal9 indm9m
CONNECT metal9 indm9p
CONNECT metal9 sline_m9m
CONNECT metal9 sline_m9p
CONNECT n_pplug tpdiff
CONNECT ncoll1 nxwell_npn
CONNECT nplug tndiff
CONNECT ntap tndiff
CONNECT poly crown -BY blc;
CONNECT poly poly_rf
CONNECT pplug tpdiff
CONNECT ptap tpdiff
CONNECT s_nd25hvdw tndiff
CONNECT s_pd25hvd tpdiff
CONNECT s_tndiff tndiff
CONNECT s_tndiff_cas tndiff
CONNECT s_tpdiff tpdiff
CONNECT tiod d_nd25hvdw
CONNECT tiod d_nd25hvi
CONNECT tiod d_pd25hvd
CONNECT tiod tndiff
CONNECT tiod tpdiff
CONNECT tndiff crown -BY blc;
CONNECT tndiff nxwell_npn -BY nplug;
CONNECT tndiff tpdiff
CONNECT tndiff ydio_ass
CONNECT tndiff ydio_hole
CONNECT tpdiff crown -BY blc;
CONNECT vargt poly
CONNECT vargt_18 poly
CONNECT vargt_25 poly
CONNECT vargt_33 poly
CONNECT vargtlpg poly

#IFDEF RC_DECK
CONNECT  poly gate;
CONNECT  nxwell poly_term -BY poly_nw_via;
CONNECT  nxwell PROBEM5_T -BY PROBEM5_B;
CONNECT  nxwell PROBEM2_T -BY PROBEM2_B;
CONNECT  nxwell DNW -BY dnwc;
CONNECT  nxwell PROBEM3_T -BY PROBEM3_B;
CONNECT  nxwell PROBEM7_T -BY PROBEM7_B;
CONNECT  nxwell PROBEM1_T -BY PROBEM1_B;
CONNECT  nxwell PROBEM4_T -BY PROBEM4_B;
CONNECT  nxwell PROBEM6_T -BY PROBEM6_B;
CONNECT  psub poly_term -BY poly_psub_via;
CONNECT  psub PROBEM5_T -BY PROBEM5_B;
CONNECT  psub PROBEM2_T -BY PROBEM2_B;
CONNECT  psub RFDMY_hia_psub -BY rf_hia_via;
CONNECT  psub PROBEM3_T -BY PROBEM3_B;
CONNECT  psub PROBEM7_T -BY PROBEM7_B;
CONNECT  psub PROBEM1_T -BY PROBEM1_B;
CONNECT  psub rfdmy56 -BY rfdmy56_via;
CONNECT  psub PROBEM4_T -BY PROBEM4_B;
CONNECT  psub PROBEM6_T -BY PROBEM6_B;
CONNECT  tpdiff rwel -BY pplug;
CONNECT  tpdiff psub_term -BY pplug;
CONNECT  tpdiff psub -BY pplug;
CONNECT  tpdiff HVPSUB -BY hvptap;
CONNECT  tpdiff HVPW -BY hvptap;
CONNECT  tpdiff RFDMY_hia -BY hiaplug;
CONNECT  tpdiff coll1 -BY pplug;
CONNECT  HVNW DNW -BY dnwc_hvnw;
CONNECT  tndiff nxwell -BY nplug;
CONNECT  tndiff HVNW -BY ntaphv;
#ENDIF

#IFNDEF RC_DECK
SCONNECT nxwell poly_term -BY poly_nw_via;
SCONNECT nxwell PROBEM5_T -BY PROBEM5_B;
SCONNECT nxwell PROBEM2_T -BY PROBEM2_B;
SCONNECT nxwell DNW -BY dnwc;
SCONNECT nxwell PROBEM3_T -BY PROBEM3_B;
SCONNECT nxwell PROBEM7_T -BY PROBEM7_B;
SCONNECT nxwell PROBEM1_T -BY PROBEM1_B;
SCONNECT nxwell PROBEM4_T -BY PROBEM4_B;
SCONNECT nxwell PROBEM6_T -BY PROBEM6_B;
SCONNECT psub poly_term -BY poly_psub_via;
SCONNECT psub PROBEM5_T -BY PROBEM5_B;
SCONNECT psub PROBEM2_T -BY PROBEM2_B;
SCONNECT psub RFDMY_hia_psub -BY rf_hia_via;
SCONNECT psub PROBEM3_T -BY PROBEM3_B;
SCONNECT psub PROBEM7_T -BY PROBEM7_B;
SCONNECT psub PROBEM1_T -BY PROBEM1_B;
SCONNECT psub rfdmy56 -BY rfdmy56_via;
SCONNECT psub PROBEM4_T -BY PROBEM4_B;
SCONNECT psub PROBEM6_T -BY PROBEM6_B;
SCONNECT tpdiff rwel -BY pplug;
#IFNDEF NW_RING
  SCONNECT tpdiff n_psub -BY n_pplug;
#ENDIF
SCONNECT tpdiff psub_term -BY pplug;
SCONNECT tpdiff psub -BY pplug;
SCONNECT tpdiff HVPSUB -BY hvptap;
SCONNECT tpdiff HVPW -BY hvptap;
SCONNECT tpdiff RFDMY_hia -BY hiaplug;
SCONNECT tpdiff coll1 -BY pplug;
SCONNECT HVNW DNW -BY dnwc_hvnw;
SCONNECT tndiff nxwell -BY nplug;
SCONNECT tndiff HVNW -BY ntaphv;
#ENDIF
