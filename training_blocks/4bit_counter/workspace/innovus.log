@file 31: # --- Libraries ---
@file 32: set LIB_TC        "${WORK_DIR}/libraries/libs/tcbn65lptc.lib"
@file 33: set LIB_WC        "${WORK_DIR}/libraries/libs/tcbn65lpwc.lib"
@file 34: set LIB_BC        "${WORK_DIR}/libraries/libs/tcbn65lpbc.lib"
@file 35:
@file 36: # --- Cap Tables ---
@file 37: set CAPTABLE_TC   "${WORK_DIR}/inputs/mmmc_files/captable/cln65lp_1p09m+alrdl_top2_typical.captable"
