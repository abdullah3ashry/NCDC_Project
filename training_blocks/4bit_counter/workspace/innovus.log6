@file 1: # ==============================================================================
@file 2: # CADENCE MMMC (Multi-Mode Multi-Corner) SETUP FILE
@file 3: # ==============================================================================
@file 4:
@file 5: # ------------------------------------------------------------------------------
@file 6: # 0. SAFETY CHECK & FILE PATH VARIABLES
@file 7: # ------------------------------------------------------------------------------
@file 8: # If this script is run standalone and INCLUDE_DFT isn't set, default to false.
@file 9: if {![info exists INCLUDE_DFT]} {
@file 10: set INCLUDE_DFT "false"
@file 11: }
@file 12:
@file 13: # ------------------------------------------------------------------------------
@file 14: # â ï¸ IMPORTANT: UPDATE THIS DIRECTORY PATH FOR YOUR SPECIFIC PC â ï¸
@file 15: # ------------------------------------------------------------------------------
@file 16: # NOTE FOR USERS: Change the WORK_DIR path below to point to where you saved 
@file 17: # the project folder on your specific computer. 
@file 18: # Example: "/home/your_username/Desktop/Lab01_Data"
@file 19: # Since all other paths are dynamic, this is the ONLY path you need to change!
@file 20:
@file 21: set WORK_DIR "/home/cc/Documents/Abdullah/Lab01_Materials/Lab01_Data"
@file 22:
@file 23: # ------------------------------------------------------------------------------
@file 24: # --- Auto-Generated Sub-Paths (Do not change these) ---
@file 25: # ------------------------------------------------------------------------------
@file 26:
@file 27: # --- SDC Files ---
@file 28: set SDC_FUNC_FILE "${WORK_DIR}/inputs/new_counter.sdc"
@file 29: set SDC_TEST_FILE "${WORK_DIR}/inputs/counter_dft.sdc"
@file 30:
@file 31: # --- Libraries ---
@file 32: set LIB_TC        "${WORK_DIR}/libraries/libs/tcbn65lptc.lib"
@file 33: set LIB_WC        "${WORK_DIR}/libraries/libs/tcbn65lpwc.lib"
@file 34: set LIB_BC        "${WORK_DIR}/libraries/libs/tcbn65lpbc.lib"
@file 35:
@file 36: # --- Cap Tables ---
@file 37: set CAPTABLE_TC   "${WORK_DIR}/inputs/mmmc_files/captable/cln65lp_1p09m+alrdl_top2_typical.captable"
@file 38: set CAPTABLE_WC   "${WORK_DIR}/inputs/mmmc_files/captable/cln65lp_1p09m+alrdl_top2_rcworst.captable"
@file 39: set CAPTABLE_BC   "${WORK_DIR}/inputs/mmmc_files/captable/cln65lp_1p09m+alrdl_top2_rcbest.captable"
@file 40:
@file 41: # ------------------------------------------------------------------------------
@file 42: # 1. LIBRARY SETS (Logical Timing & Power)
@file 43: # ------------------------------------------------------------------------------
@@file 44: create_library_set -name tc_libset -timing $LIB_TC
@@file 45: create_library_set -name wc_libset -timing $LIB_WC
@@file 46: create_library_set -name bc_libset -timing $LIB_BC
@file 47:
@file 48: # ------------------------------------------------------------------------------
@file 49: # 2. TIMING CONDITIONS
@file 50: # ------------------------------------------------------------------------------
@@file 51: create_timing_condition -name tc_cond -library_sets {tc_libset}
@@file 52: create_timing_condition -name wc_cond -library_sets {wc_libset}
@@file 53: create_timing_condition -name bc_cond -library_sets {bc_libset}
@file 54:
@file 55: # ------------------------------------------------------------------------------
@file 56: # 3. RC CORNERS (Physical Interconnect Parasitics)
@file 57: # ------------------------------------------------------------------------------
@@file 58: create_rc_corner -name rc_typical -temperature 25  -cap_table $CAPTABLE_TC
@@file 59: create_rc_corner -name rc_worst   -temperature 125 -cap_table $CAPTABLE_WC
@@file 60: create_rc_corner -name rc_best    -temperature -40 -cap_table $CAPTABLE_BC
@file 61:
@file 62: # ------------------------------------------------------------------------------
@file 63: # 4. CONSTRAINT MODES (Design Goals)
@file 64: # ------------------------------------------------------------------------------
@file 65: # Mode 1: Functional (Always Active) - High speed standard operation
@@file 66: create_constraint_mode -name func_mode -sdc_files $SDC_FUNC_FILE
@file 67:
@file 68: # Mode 2: Test (Conditional) - Slow clock, shifting data for scan chains
@file 69: if {$INCLUDE_DFT == "true"} {...}
@file 72:
@file 73: # ------------------------------------------------------------------------------
@file 74: # 5. DELAY CORNERS (Merging Logic and Physics)
@file 75: # ------------------------------------------------------------------------------
@@file 76: create_delay_corner -name dc_typical -timing_condition {tc_cond} -rc_corner {rc_typical}
@@file 77: create_delay_corner -name dc_worst   -timing_condition {wc_cond} -rc_corner {rc_worst}
@@file 78: create_delay_corner -name dc_best    -timing_condition {bc_cond} -rc_corner {rc_best}
@file 79:
@file 80: # ------------------------------------------------------------------------------
@file 81: # 6. ANALYSIS VIEWS (Merging Delays and Constraints)
@file 82: # ------------------------------------------------------------------------------
@file 83: # Create Functional Views
@@file 84: create_analysis_view -name view_func_typical -constraint_mode {func_mode} -delay_corner {dc_typical}
@@file 85: create_analysis_view -name view_func_setup   -constraint_mode {func_mode} -delay_corner {dc_worst}
@@file 86: create_analysis_view -name view_func_hold    -constraint_mode {func_mode} -delay_corner {dc_best}
@file 87:
@file 88: # Create Test Views (If DFT is enabled)
@file 89: if {$INCLUDE_DFT == "true"} {...}
@file 94:
@file 95: # ------------------------------------------------------------------------------
@file 96: # 7. SET ACTIVE VIEWS
@file 97: # ------------------------------------------------------------------------------
@file 98: # If DFT is enabled, we force the tool to balance timing for BOTH modes.
@file 99: # However, Genus requires a single, primary view for power analysis (leakage/dynamic).
@file 100: if {$INCLUDE_DFT == "true"} {...
@file 106: } else {
@@file 107: set_analysis_view  -setup   {view_func_setup}  -hold    {view_func_hold}  -leakage {view_func_typical}  -dynamic {view_func_typical}
@file 108: }
