[08/11 03:28:26     11s] #@ Begin verbose source (pre): source ../scripts/Innovus_SPT.tcl
[08/11 03:28:26     11s] @file 1: ################################################################################
[08/11 03:28:26     11s] @file 2: # CADENCE INNOVUS: FLAT PLACE & ROUTE SCRIPT (ANNOTATED & EXPLAINED)
[08/11 03:28:26     11s] @file 3: # Design: top_wrapper (ALU with I/O Pads)
[08/11 03:28:26     11s] @file 4: # Technology: TSMC 65nm (9-Layer Metal Stack)
[08/11 03:28:26     11s] @file 5: # Purpose: Full physical design flow from Netlist to GDSII
[08/11 03:28:26     11s] @file 6: ################################################################################
[08/11 03:28:26     11s] @file 7:
[08/11 03:28:26     11s] @file 8: # ==============================================================================
[08/11 03:28:26     11s] @file 9: # 1. PROJECT VARIABLES & SETUP
[08/11 03:28:26     11s] @file 10: # ==============================================================================
[08/11 03:28:26     11s] @file 11:
[08/11 03:28:26     11s] @file 12: # ------------------------------------------------------------------------------
[08/11 03:28:26     11s] @file 13: # â ï¸ IMPORTANT: UPDATE THIS DIRECTORY PATH FOR YOUR SPECIFIC PC â ï¸
[08/11 03:28:26     11s] @file 14: # ------------------------------------------------------------------------------
[08/11 03:28:26     11s] @file 15: # set WORK_DIR: Defines the root workspace directory. All other paths derive from this.
[08/11 03:28:26     11s] @file 16: set WORK_DIR                  "/home/cc/Documents/Abdullah/Lab_04_Data"
[08/11 03:28:26     11s] @file 17: # ------------------------------------------------------------------------------
[08/11 03:28:26     11s] @file 18:
[08/11 03:28:26     11s] @file 19: # set design(TOPLEVEL): Defines the name of the top module to be used in output files.
[08/11 03:28:26     11s] @file 20: set design(TOPLEVEL)          "top_wrapper"
[08/11 03:28:26     11s] @file 21:
[08/11 03:28:26     11s] @file 22: # --- Output Infrastructure & Directory Creation ---
[08/11 03:28:26     11s] @file 23: # Define paths for saving Innovus outputs (GDS, Netlists) and reports.
[08/11 03:28:26     11s] @file 24: set INNOVUS_DATA_DIR          "${WORK_DIR}/export/Innovus_Data"
[08/11 03:28:26     11s] @file 25: set design(export_dir)        "${INNOVUS_DATA_DIR}/outputs"
[08/11 03:28:26     11s] @file 26: set design(reports_dir)       "${INNOVUS_DATA_DIR}/reports"
[08/11 03:28:26     11s] @file 27:
[08/11 03:28:26     11s] @file 28: # file mkdir: Instructs the OS to create the folder hierarchy to avoid 'directory not found' errors.
[08/11 03:28:26     11s] @file 29: file mkdir $INNOVUS_DATA_DIR \
[08/11 03:28:26     11s]            ${design(export_dir)}/pnr \
[08/11 03:28:26     11s]            ${design(reports_dir)}/verify \
[08/11 03:28:26     11s]            ${design(reports_dir)}/signoff \
[08/11 03:28:26     11s]            ${design(reports_dir)}/placement \
[08/11 03:28:26     11s]            ${design(reports_dir)}/opt \
[08/11 03:28:26     11s]            ${design(reports_dir)}/cts \
[08/11 03:28:26     11s]            ${design(reports_dir)}/route
[08/11 03:28:26     11s] @file 37:
[08/11 03:28:26     11s] @file 38: # --- Inputs ---
[08/11 03:28:26     11s] @file 39: # Link the gate-level netlist generated by the Genus Synthesis tool.
[08/11 03:28:26     11s] @file 40: set design(postsyn_netlist)   "${WORK_DIR}/export/Synthesis_Data/netlists/${design(TOPLEVEL)}_physical_synth.v"
[08/11 03:28:26     11s] @file 41: # Link the MMMC (Multi-Mode Multi-Corner) file for timing constraints (SDC) and RC corners.
[08/11 03:28:26     11s] @file 42: set design(mmmc_view_file)    "${WORK_DIR}/inputs/mmmc_master.view"
[08/11 03:28:26     11s] @file 43: # Link the IO file which dictates exact coordinates for input/output pad pins.
[08/11 03:28:26     11s] @file 44: set design(io_file)           "${WORK_DIR}/inputs/ALU.io"
[08/11 03:28:26     11s] @file 45: # Link the LEF files (Standard Logic Cells + I/O Pad Cells)
[08/11 03:28:26     11s] @file 46: set tech(ALL_LEFS)            [list \
[08/11 03:28:26     11s]                                   "${WORK_DIR}/libraries/lef/tcbn65lp_9lmT2.lef" \
[08/11 03:28:26     11s]                                   "${WORK_DIR}/libraries/lef/tpzn65lpgv2od3_9lm.lef" \
[08/11 03:28:26     11s]                               ]
[08/11 03:28:26     11s] @file 50:
[08/11 03:28:26     11s] @file 51: # --- Cell Library Definitions ---
[08/11 03:28:26     11s] @file 52: # Map the logical power/ground pins to physical cell references.
[08/11 03:28:26     11s] @file 53: set tech(STANDARD_CELL_VDD)   "VDD"
[08/11 03:28:26     11s] @file 54: set tech(STANDARD_CELL_GND)   "VSS"
[08/11 03:28:26     11s] @file 55: # Specify the cells used at the ends of standard cell rows to prevent well-spacing DRCs.
[08/11 03:28:26     11s] @file 56: set tech(ENDCAPS_right)       "DCAP"    
[08/11 03:28:26     11s] @file 57: set tech(ENDCAPS_left)        "DCAP"
[08/11 03:28:26     11s] @file 58: # Specify cells used to tie logic '1' and logic '0' without connecting directly to PG rails.
[08/11 03:28:26     11s] @file 59: set tech(TIEHI)               "TIEH"
[08/11 03:28:26     11s] @file 60: set tech(TIELO)               "TIEL"
[08/11 03:28:26     11s] @file 61: # Limit the fanout of tie cells so they don't get overloaded.
[08/11 03:28:26     11s] @file 62: set tech(TIE_MAX_FANOUT)      10
[08/11 03:28:26     11s] @file 63: # List of Decoupling Capacitor and Filler cells to fill empty spaces in the floorplan.
[08/11 03:28:26     11s] @file 64: set tech(DECAP)               "DCAP64 DCAP32 DCAP16 DCAP8 DCAP4 DCAP"
[08/11 03:28:26     11s] @file 65: set tech(FILLERS)             "FILL64 FILL32 FILL16 FILL8 FILL4 FILL2 FILL1"
[08/11 03:28:26     11s] @file 66:
[08/11 03:28:26     11s] @file 67: # --- Global Net Definitions ---
[08/11 03:28:26     11s] @file 68: # Explicitly name the global power and ground nets for routing.
[08/11 03:28:26     11s] @file 69: set design(digital_gnd)       "VSS"
[08/11 03:28:26     11s] @file 70: set design(digital_vdd)       "VDD"
[08/11 03:28:26     11s] @file 71: set design(all_ground_nets)   $design(digital_gnd)
[08/11 03:28:26     11s] @file 72: set design(all_power_nets)    $design(digital_vdd)
[08/11 03:28:26     11s] @file 73: set design(core_ring_nets)    "$design(digital_gnd) $design(digital_vdd)"
[08/11 03:28:26     11s] @file 74:
[08/11 03:28:26     11s] @file 75:
[08/11 03:28:26     11s] @file 76: # ==============================================================================
[08/11 03:28:26     11s] @file 77: # 2. TOOL SETTINGS & INITIALIZATION
[08/11 03:28:26     11s] @file 78: # ==============================================================================
[08/11 03:28:26     11s] @file 79: puts "INFO: Starting Stage - Initialization"
[08/11 03:28:26     11s] INFO: Starting Stage - Initialization
[08/11 03:28:26     11s] @file 80:
[08/11 03:28:26     11s] @file 81: # set_library_unit: Sets the base units for time and capacitance for the tool's internal engine.
[08/11 03:28:26     11s] @@file 82: set_library_unit -time 1ns -cap 1pf
[08/11 03:28:26     11s] @file 83: # timing_analysis_type ocv: Enables On-Chip Variation to account for physical manufacturing differences.
[08/11 03:28:26     11s] @@file 84: set_db timing_analysis_type ocv
[08/11 03:28:26     11s] @file 85: # timing_analysis_cppr both: Enables Clock Pessimism Removal for more accurate timing in common clock paths.
[08/11 03:28:26     11s] @@file 86: set_db timing_analysis_cppr both
[08/11 03:28:26     11s] @file 87: # timing_report_unconstrained_paths: Forces the tool to report paths missing SDC constraints.
[08/11 03:28:26     11s] @@file 88: set_db timing_report_unconstrained_paths true
[08/11 03:28:26     11s] @file 89:
[08/11 03:28:26     11s] @file 90: # init_ground/power_nets: Tells Innovus which nets act as global VDD and VSS before loading the design.
[08/11 03:28:26     11s] @@file 91: set_db init_ground_nets $design(all_ground_nets)
[08/11 03:28:26     11s] @@file 92: set_db init_power_nets  $design(all_power_nets)
[08/11 03:28:26     11s] @file 93:
[08/11 03:28:26     11s] @file 94: # Load constraints (MMMC), physical shapes (LEF), IO definitions, and logical gates (Netlist).
[08/11 03:28:26     11s] @@file 95: read_mmmc $design(mmmc_view_file) 
