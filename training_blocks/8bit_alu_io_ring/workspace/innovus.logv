[08/11 03:28:26     11s] @file 31:
[08/11 03:28:26     11s] @file 32: # --- Standard Cell Libraries (Logic) ---
[08/11 03:28:26     11s] @file 33: set LIB_TC        "${WORK_DIR}/libraries/libs/tcbn65lptc.lib"
[08/11 03:28:26     11s] @file 34: set LIB_WC        "${WORK_DIR}/libraries/libs/tcbn65lpwc.lib"
[08/11 03:28:26     11s] @file 35: set LIB_BC        "${WORK_DIR}/libraries/libs/tcbn65lpbc.lib"
[08/11 03:28:26     11s] @file 36:
