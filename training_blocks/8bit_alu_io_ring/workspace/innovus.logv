[08/11 03:28:26     11s] @file 38: set IO_LIB_TC     "${WORK_DIR}/libraries/libs/tpzn65lpgv2od3tc.lib"
[08/11 03:28:26     11s] @file 39: set IO_LIB_WC     "${WORK_DIR}/libraries/libs/tpzn65lpgv2od3wc.lib"
[08/11 03:28:26     11s] @file 40: set IO_LIB_BC     "${WORK_DIR}/libraries/libs/tpzn65lpgv2od3bc.lib"
[08/11 03:28:26     11s] @file 41:
[08/11 03:28:26     11s] @file 42: # --- Cap Tables ---
[08/11 03:28:26     11s] @file 43: set CAPTABLE_TC   "${WORK_DIR}/inputs/mmmc_files/captable/cln65lp_1p09m+alrdl_top2_typical.captable"
[08/11 03:28:26     11s] @file 44: set CAPTABLE_WC   "${WORK_DIR}/inputs/mmmc_files/captable/cln65lp_1p09m+alrdl_top2_rcworst.captable"
[08/11 03:28:26     11s] @file 45: set CAPTABLE_BC   "${WORK_DIR}/inputs/mmmc_files/captable/cln65lp_1p09m+alrdl_top2_rcbest.captable"
[08/11 03:28:26     11s] @file 46:
[08/11 03:28:26     11s] @file 47: # ------------------------------------------------------------------------------
[08/11 03:28:26     11s] @file 48: # 1. LIBRARY SETS (Logical Timing & Power)
[08/11 03:28:26     11s] @file 49: # ------------------------------------------------------------------------------
[08/11 03:28:26     11s] @file 50: # Merging Core Logic and I/O Timing into single sets for each corner
[08/11 03:28:26     11s] @@file 51: create_library_set -name tc_libset -timing [list $LIB_TC $IO_LIB_TC]
[08/11 03:28:26     11s] @@file 52: create_library_set -name wc_libset -timing [list $LIB_WC $IO_LIB_WC]
[08/11 03:28:26     11s] @@file 53: create_library_set -name bc_libset -timing [list $LIB_BC $IO_LIB_BC]
[08/11 03:28:26     11s] @file 54:
