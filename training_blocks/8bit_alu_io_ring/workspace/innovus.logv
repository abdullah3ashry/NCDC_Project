[08/11 03:28:26     11s] @file 76: if {$INCLUDE_DFT == "true"} {...}
[08/11 03:28:26     11s] @file 79:
[08/11 03:28:26     11s] @file 80: # ------------------------------------------------------------------------------
[08/11 03:28:26     11s] @file 81: # 5. DELAY CORNERS (Merging Logic and Physics)
[08/11 03:28:26     11s] @file 82: # ------------------------------------------------------------------------------
[08/11 03:28:26     11s] @@file 83: create_delay_corner -name dc_typical -timing_condition {tc_cond} -rc_corner {rc_typical}
[08/11 03:28:26     11s] @@file 84: create_delay_corner -name dc_worst   -timing_condition {wc_cond} -rc_corner {rc_worst}
[08/11 03:28:26     11s] @@file 85: create_delay_corner -name dc_best    -timing_condition {bc_cond} -rc_corner {rc_best}
[08/11 03:28:26     11s] @file 86:
[08/11 03:28:26     11s] @file 87: # ------------------------------------------------------------------------------
[08/11 03:28:26     11s] @file 88: # 6. ANALYSIS VIEWS (Merging Delays and Constraints)
[08/11 03:28:26     11s] @file 89: # ------------------------------------------------------------------------------
[08/11 03:28:26     11s] @file 90: # Create Functional Views
[08/11 03:28:26     11s] @@file 91: create_analysis_view -name view_func_typical -constraint_mode {func_mode} -delay_corner {dc_typical}
[08/11 03:28:26     11s] @@file 92: create_analysis_view -name view_func_setup   -constraint_mode {func_mode} -delay_corner {dc_worst}
[08/11 03:28:26     11s] @@file 93: create_analysis_view -name view_func_hold    -constraint_mode {func_mode} -delay_corner {dc_best}
[08/11 03:28:26     11s] @file 94:
