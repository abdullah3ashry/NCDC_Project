[08/11 03:28:26     11s] @file 56: # 2. TIMING CONDITIONS
[08/11 03:28:26     11s] @file 57: # ------------------------------------------------------------------------------
[08/11 03:28:26     11s] @@file 58: create_timing_condition -name tc_cond -library_sets {tc_libset}
[08/11 03:28:26     11s] @@file 59: create_timing_condition -name wc_cond -library_sets {wc_libset}
[08/11 03:28:26     11s] @@file 60: create_timing_condition -name bc_cond -library_sets {bc_libset}
[08/11 03:28:26     11s] @file 61:
[08/11 03:28:26     11s] @file 62: # ------------------------------------------------------------------------------
[08/11 03:28:26     11s] @file 63: # 3. RC CORNERS (Physical Interconnect Parasitics)
[08/11 03:28:26     11s] @file 64: # ------------------------------------------------------------------------------
[08/11 03:28:26     11s] @@file 65: create_rc_corner -name rc_typical -temperature 25  -cap_table $CAPTABLE_TC
[08/11 03:28:26     11s] @@file 66: create_rc_corner -name rc_worst   -temperature 125 -cap_table $CAPTABLE_WC
[08/11 03:28:26     11s] @@file 67: create_rc_corner -name rc_best    -temperature -40 -cap_table $CAPTABLE_BC
[08/11 03:28:26     11s] @file 68:
[08/11 03:28:26     11s] @file 69: # ------------------------------------------------------------------------------
[08/11 03:28:26     11s] @file 70: # 4. CONSTRAINT MODES (Design Goals)
[08/11 03:28:26     11s] @file 71: # ------------------------------------------------------------------------------
[08/11 03:28:26     11s] @file 72: # Mode 1: Functional (Always Active) - High speed standard operation
[08/11 03:28:26     11s] @@file 73: create_constraint_mode -name func_mode -sdc_files [list $SDC_FUNC_FILE]
[08/11 03:28:26     11s] @file 74:
