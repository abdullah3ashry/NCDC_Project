@file 1: # ==============================================================================
@file 2: # CADENCE MMMC (Multi-Mode Multi-Corner) SETUP FILE
@file 3: # Project: ALU with I/O Pads
@file 4: # ==============================================================================
@file 5:
@file 6: # ------------------------------------------------------------------------------
@file 7: # 0. SAFETY CHECK & FILE PATH VARIABLES
@file 8: # ------------------------------------------------------------------------------
@file 9: # If this script is run standalone and INCLUDE_DFT isn't set, default to false.
@file 10: if {![info exists INCLUDE_DFT]} {
@file 11: set INCLUDE_DFT "false"
@file 12: }
@file 13:
@file 14: # ------------------------------------------------------------------------------
@file 15: # â ï¸ IMPORTANT: UPDATE THIS DIRECTORY PATH FOR YOUR SPECIFIC PC â ï¸
@file 16: # ------------------------------------------------------------------------------
@file 17: # NOTE FOR USERS: Change the WORK_DIR path below to point to where you saved 
@file 18: # the project folder on your specific computer. 
@file 19: # Example: "/home/your_username/Desktop/Lab01_Data"
@file 20: # Since all other paths are dynamic, this is the ONLY path you need to change!
@file 21:
@file 22: set WORK_DIR "/home/cc/Documents/Abdullah/Lab_04_Data"
@file 23:
@file 24: # ------------------------------------------------------------------------------
@file 25: # --- Auto-Generated Sub-Paths (Do not change these) ---
@file 26: # ------------------------------------------------------------------------------
@file 27:
@file 28: # --- SDC Files ---
@file 29: set SDC_FUNC_FILE "${WORK_DIR}/inputs/ALU.sdc"
@file 30: #set SDC_TEST_FILE "${WORK_DIR}/inputs/alu_dft.sdc"
@file 31:
@file 32: # --- Standard Cell Libraries (Logic) ---
@file 33: set LIB_TC        "${WORK_DIR}/libraries/libs/tcbn65lptc.lib"
@file 34: set LIB_WC        "${WORK_DIR}/libraries/libs/tcbn65lpwc.lib"
@file 35: set LIB_BC        "${WORK_DIR}/libraries/libs/tcbn65lpbc.lib"
@file 36:
@file 37: # --- I/O Pad Libraries (Physical Interface) ---
@file 38: set IO_LIB_TC     "${WORK_DIR}/libraries/libs/tpzn65lpgv2od3tc.lib"
@file 39: set IO_LIB_WC     "${WORK_DIR}/libraries/libs/tpzn65lpgv2od3wc.lib"
@file 40: set IO_LIB_BC     "${WORK_DIR}/libraries/libs/tpzn65lpgv2od3bc.lib"
@file 41:
@file 42: # --- Cap Tables ---
@file 43: set CAPTABLE_TC   "${WORK_DIR}/inputs/mmmc_files/captable/cln65lp_1p09m+alrdl_top2_typical.captable"
@file 44: set CAPTABLE_WC   "${WORK_DIR}/inputs/mmmc_files/captable/cln65lp_1p09m+alrdl_top2_rcworst.captable"
@file 45: set CAPTABLE_BC   "${WORK_DIR}/inputs/mmmc_files/captable/cln65lp_1p09m+alrdl_top2_rcbest.captable"
@file 46:
@file 47: # ------------------------------------------------------------------------------
@file 48: # 1. LIBRARY SETS (Logical Timing & Power)
@file 49: # ------------------------------------------------------------------------------
@file 50: # Merging Core Logic and I/O Timing into single sets for each corner
@@file 51: create_library_set -name tc_libset -timing [list $LIB_TC $IO_LIB_TC]
@@file 52: create_library_set -name wc_libset -timing [list $LIB_WC $IO_LIB_WC]
@@file 53: create_library_set -name bc_libset -timing [list $LIB_BC $IO_LIB_BC]
@file 54:
@file 55: # ------------------------------------------------------------------------------
@file 56: # 2. TIMING CONDITIONS
@file 57: # ------------------------------------------------------------------------------
@@file 58: create_timing_condition -name tc_cond -library_sets {tc_libset}
@@file 59: create_timing_condition -name wc_cond -library_sets {wc_libset}
@@file 60: create_timing_condition -name bc_cond -library_sets {bc_libset}
@file 61:
@file 62: # ------------------------------------------------------------------------------
@file 63: # 3. RC CORNERS (Physical Interconnect Parasitics)
@file 64: # ------------------------------------------------------------------------------
@@file 65: create_rc_corner -name rc_typical -temperature 25  -cap_table $CAPTABLE_TC
@@file 66: create_rc_corner -name rc_worst   -temperature 125 -cap_table $CAPTABLE_WC
@@file 67: create_rc_corner -name rc_best    -temperature -40 -cap_table $CAPTABLE_BC
@file 68:
@file 69: # ------------------------------------------------------------------------------
@file 70: # 4. CONSTRAINT MODES (Design Goals)
@file 71: # ------------------------------------------------------------------------------
@file 72: # Mode 1: Functional (Always Active) - High speed standard operation
@@file 73: create_constraint_mode -name func_mode -sdc_files [list $SDC_FUNC_FILE]
@file 74:
@file 75: # Mode 2: Test (Conditional) - Slow clock, shifting data for scan chains
@file 76: if {$INCLUDE_DFT == "true"} {...}
@file 79:
@file 80: # ------------------------------------------------------------------------------
@file 81: # 5. DELAY CORNERS (Merging Logic and Physics)
@file 82: # ------------------------------------------------------------------------------
@@file 83: create_delay_corner -name dc_typical -timing_condition {tc_cond} -rc_corner {rc_typical}
@@file 84: create_delay_corner -name dc_worst   -timing_condition {wc_cond} -rc_corner {rc_worst}
@@file 85: create_delay_corner -name dc_best    -timing_condition {bc_cond} -rc_corner {rc_best}
@file 86:
@file 87: # ------------------------------------------------------------------------------
@file 88: # 6. ANALYSIS VIEWS (Merging Delays and Constraints)
@file 89: # ------------------------------------------------------------------------------
@file 90: # Create Functional Views
@@file 91: create_analysis_view -name view_func_typical -constraint_mode {func_mode} -delay_corner {dc_typical}
@@file 92: create_analysis_view -name view_func_setup   -constraint_mode {func_mode} -delay_corner {dc_worst}
@@file 93: create_analysis_view -name view_func_hold    -constraint_mode {func_mode} -delay_corner {dc_best}
@file 94:
@file 95: # Create Test Views (If DFT is enabled)
@file 96: if {$INCLUDE_DFT == "true"} {...}
@file 101:
@file 102: # ------------------------------------------------------------------------------
@file 103: # 7. SET ACTIVE VIEWS
@file 104: # ------------------------------------------------------------------------------
@file 105: # If DFT is enabled, we force the tool to balance timing for BOTH modes.
@file 106: # However, Genus requires a single, primary view for power analysis (leakage/dynamic).
@file 107: if {$INCLUDE_DFT == "true"} {...
@file 113: } else {
@@file 114: set_analysis_view  -setup   {view_func_setup}  -hold    {view_func_hold}  -leakage {view_func_typical}  -dynamic {view_func_typical}
