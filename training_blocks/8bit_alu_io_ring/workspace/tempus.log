@file 47: # ------------------------------------------------------------------------------
@file 48: # 1. LIBRARY SETS (Logical Timing & Power)
@file 49: # ------------------------------------------------------------------------------
@file 50: # Merging Core Logic and I/O Timing into single sets for each corner
@@file 51: create_library_set -name tc_libset -timing [list $LIB_TC $IO_LIB_TC]
@@file 52: create_library_set -name wc_libset -timing [list $LIB_WC $IO_LIB_WC]
@@file 53: create_library_set -name bc_libset -timing [list $LIB_BC $IO_LIB_BC]
