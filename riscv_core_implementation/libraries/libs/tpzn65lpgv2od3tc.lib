/*******************************************************************
*                   LIBRARY :   tpzn65lpgv2od3tc
*                   Method  :   Stuff cells timing/power using
*                               Y.T. TSENG (TSMC STD. I/O CHARACTERIZATION)
*                   Comment :   This library was created by
*                               TSMC SYNOPSYS TEMPLATE library
*                               Engineer should take care library dependent
*                               technology such as template,
*                               voltage, process k factor and
*                               predicted wire loading etc
*                   Update  :
*                               version 200b 
*                               Wed Sep 29 10:52:40 2010
********************************************************************/
library (tpzn65lpgv2od3tc) { 
    technology (cmos) ;
    delay_model : table_lookup ;
    date        : "Wed Sep 29 10:52:40 2010" ;
    comment : "Copyright TSMC" ;
    revision    : 200b ;
    simulation 	: true ;
    /* Define all power rails */
    power_supply() {                 
      default_power_rail : IO_VOLTAGE;
      power_rail ( CORE_VOLTAGE, 1.2);  
      power_rail ( IO_VOLTAGE, 3.3);
    }
    nom_process         : 1 ;
    nom_temperature : 25 ;
    nom_voltage 	: 3.3 ;
  
    operating_conditions("NCCOM"){
        process : 1;
        temperature : 25 ;
        voltage : 3.3 ;
        tree_type : "balanced_tree" ;
	power_rail ( CORE_VOLTAGE, 1.2);  
        power_rail ( IO_VOLTAGE, 3.3);
    }
    default_operating_conditions : NCCOM ;
    capacitive_load_unit (1,pf) ;
    voltage_unit : "1V" ;
    current_unit : "1mA" ;
    time_unit : "1ns" ;
    pulling_resistance_unit : "1kohm"; 
    define_cell_area (pad_drivers,pad_driver_sites) ;
    define_cell_area(bond_pads,pad_slots) ;
    library_features (report_delay_calculation);
    library_features (report_power_calculation);
    input_voltage(cmos) {
        vil : 0.3 * VDD ;
        vih : 0.7 * VDD ;
        vimin : -0.5 ;
        vimax : VDD + 0.5 ;
    }
    input_voltage(cmos_schmitt) {
         vil : 0.3 * VDD ;
         vih : 0.7 * VDD ;
         vimin : -0.5 ;
         vimax : VDD + 0.5 ;
    }
    input_voltage(schmitt) {
         vil : 0.3 * VDD ;
         vih : 0.7 * VDD ;
         vimin : -0.5 ;
         vimax : VDD + 0.5 ;
    }
    input_voltage(ttl) {
         vil : 0.8 ;
         vih : 2 ;
         vimin : -0.5 ;
         vimax : VDD + 0.5 ;
    }
    input_voltage(ttl_schmitt) {
         vil : 0.8 ;
         vih : 2 ;
         vimin : -0.5 ;
         vimax : VDD + 0.5 ;
    }
    input_voltage(pci) {
         vil : 0.8 ;
         vih : 2 ;
         vimin : -0.5 ;
         vimax : VDD + 0.5 ;
    }
    output_voltage(cmos) {
         vol : 0.3 * VDD ;
         voh : 0.7 * VDD ;
         vomin : -0.5 ;
         vomax : VDD + 0.5 ;
    }
    output_voltage(cmos_schmitt) {
         vol : 0.3 * VDD ;
         voh : 0.7 * VDD ;
         vomin : -0.5 ;
         vomax : VDD + 0.5 ;
    }
    output_voltage(schmitt) {
         vol : 0.3 * VDD ;
         voh : 0.7 * VDD ;
         vomin : -0.5 ;
         vomax : VDD + 0.5 ;
    }
    output_voltage(ttl) {
         vol : 0.4 ;
         voh : 2.4 ;
         vomin : -0.5 ;
         vomax : VDD + 0.5 ;
    }
    output_voltage(ttl_schmitt) {
         vol : 0.4 ;
         voh : 2.4 ;
         vomin : -0.5 ;
         vomax : VDD + 0.5 ;
    }
    output_voltage(pci) {
         vol : 0.4 ;
         voh : 2.4 ;
         vomin : -0.5 ;
         vomax : VDD + 0.5 ;
    }

