@file 11:
@file 12: # --- SDC Files ---
@file 13: set SDC_FUNC_FILE "${WORK_DIR}/inputs/riscv_baseline.sdc"
@file 14: set SDC_TEST_FILE "${WORK_DIR}/inputs/riscv_dft.sdc"
@file 15:
@file 16: # --- Libraries ---
@file 17: set LIB_TC        "${WORK_DIR}/libraries/libs/tcbn65lptc.lib"
@file 18: set LIB_WC        "${WORK_DIR}/libraries/libs/tcbn65lpwc.lib"
@file 19: set LIB_BC        "${WORK_DIR}/libraries/libs/tcbn65lpbc.lib"
@file 20:
@file 21: # --- Cap Tables ---
@file 22: set CAPTABLE_TC   "${WORK_DIR}/inputs/mmmc_files/captable/cln65lp_1p09m+alrdl_top2_typical.captable"
@file 23: set CAPTABLE_WC   "${WORK_DIR}/inputs/mmmc_files/captable/cln65lp_1p09m+alrdl_top2_rcworst.captable"
@file 24: set CAPTABLE_BC   "${WORK_DIR}/inputs/mmmc_files/captable/cln65lp_1p09m+alrdl_top2_rcbest.captable"
@file 25:
@file 26: # ------------------------------------------------------------------------------
@file 27: # 1. LIBRARY SETS
@file 28: # ------------------------------------------------------------------------------
@@file 29: create_library_set -name tc_libset -timing $LIB_TC
@@file 30: create_library_set -name wc_libset -timing $LIB_WC
@@file 31: create_library_set -name bc_libset -timing $LIB_BC
@file 32:
@file 33: # ------------------------------------------------------------------------------
@file 34: # 2. TIMING CONDITIONS
@file 35: # ------------------------------------------------------------------------------
@@file 36: create_timing_condition -name tc_cond -library_sets {tc_libset}
@@file 37: create_timing_condition -name wc_cond -library_sets {wc_libset}
@@file 38: create_timing_condition -name bc_cond -library_sets {bc_libset}
@file 39:
@file 40: # ------------------------------------------------------------------------------
@file 41: # 3. RC CORNERS
@file 42: # ------------------------------------------------------------------------------
@@file 43: create_rc_corner -name rc_typical -temperature 25  -cap_table $CAPTABLE_TC
@@file 44: create_rc_corner -name rc_worst   -temperature 125 -cap_table $CAPTABLE_WC
@@file 45: create_rc_corner -name rc_best    -temperature -40 -cap_table $CAPTABLE_BC
@file 46:
@file 47: # ------------------------------------------------------------------------------
@file 48: # 4. CONSTRAINT MODES
@file 49: # ------------------------------------------------------------------------------
@@file 50: create_constraint_mode -name func_mode -sdc_files $SDC_FUNC_FILE
@file 51:
@file 52: if {$INCLUDE_DFT == "true"} {...}
@file 55:
@file 56: # ------------------------------------------------------------------------------
@file 57: # 5. DELAY CORNERS
@file 58: # ------------------------------------------------------------------------------
@@file 59: create_delay_corner -name dc_typical -timing_condition {tc_cond} -rc_corner {rc_typical}
@@file 60: create_delay_corner -name dc_worst   -timing_condition {wc_cond} -rc_corner {rc_worst}
@@file 61: create_delay_corner -name dc_best    -timing_condition {bc_cond} -rc_corner {rc_best}
@file 62:
@file 63: # ------------------------------------------------------------------------------
@file 64: # 6. ANALYSIS VIEWS
@file 65: # ------------------------------------------------------------------------------
@@file 66: create_analysis_view -name view_func_typical -constraint_mode {func_mode} -delay_corner {dc_typical}
@@file 67: create_analysis_view -name view_func_setup   -constraint_mode {func_mode} -delay_corner {dc_worst}
@@file 68: create_analysis_view -name view_func_hold    -constraint_mode {func_mode} -delay_corner {dc_best}
@file 69:
@file 70: if {$INCLUDE_DFT == "true"} {...}
@file 75:
@file 76: # ------------------------------------------------------------------------------
@file 77: # 7. SET ACTIVE VIEWS
@file 78: # ------------------------------------------------------------------------------
@file 79: if {$INCLUDE_DFT == "true"} {...
@file 85: } else {
@@file 86: set_analysis_view  -setup   {view_func_setup}  -hold    {view_func_hold}  -leakage {view_func_typical}  -dynamic {view_func_typical}
@file 87: }
