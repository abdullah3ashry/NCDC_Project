database -open waves -into waves.shm -default
probe -create -shm riscv_core_tb.alu_result riscv_core_tb.clk riscv_core_tb.data_mem riscv_core_tb.dmem_write_mask riscv_core_tb.formatted_dmem_write riscv_core_tb.instr_mem riscv_core_tb.instruction riscv_core_tb.mem_read riscv_core_tb.mem_write riscv_core_tb.pc_current riscv_core_tb.raw_dmem_read riscv_core_tb.rst
run
